@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Pages
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Portfolio.Shared.Identity
@using MyPo.Portfolio.Shared.Models

@inherits CBase

<div class="container mt-3">
	<CAlert @ref="@Alert" />
	@if (PnlSummary==null || TxSettlements==null || TxSettlements.Count()==0)
	{
		<CAlert Type="warning">
			PnL Summary data is not available for this portfolio.
		</CAlert>
	}
	else
	{
		<div class="row mb-2">
			<div class="col-12">
				<div class="card text-bg-light">
					@*
					<div class="card-header">
						<h6>Investments & Returns Report</h6>
					</div>
					*@
					<div class="card-body">
						<table class="table table-sm table-borderless" style="margin-bottom: 0 !important; padding-bottom: 0 !important;">
							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									A. Capital Flows
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Total Cash In (1)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalCashIn, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Total Cash Out (2)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalCashOut, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Net Capital Contributed (3=1-2)
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.NetCapitalContributed, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>

							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									B. Investment Activity
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Total Buy (4)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalBuyValue, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Total Sell (5)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalSellValue, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>

							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									C. Returns (Income & Gains)
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Dividends (6)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalDividends, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Interest (7)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalInterest, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Total Income (8=6+7)
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalIncome, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>

							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									D. Trading Performance
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Realized Capital Gains (9=5-4)
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.RealizedCapitalGains, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>

							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									E. Costs & Taxes
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Fees (10)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalFees, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start">
									Tax (11)
								</td>
								<td class="text-end">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalTax, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Total Costs (12=10+11)
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalCosts, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>

							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									F. Returns Summary
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Gross Returns (13=8+9)
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.GrossReturns, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Net Returns (14=13-12)
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.NetReturns, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>

							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									G. Performance Metrics
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Net P/L (15=14)
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.NetPnL, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									ROI (vs Total Buy) (16=15/4)
								</td>
								<td class="text-end fw-semibold">
									@(PnlSummary.Value.ROIvsTotalBuy.ToString("N2")+"%")
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									ROI (vs Peak Capital) (17=15/PeakCapital)
								</td>
								<td class="text-end fw-semibold">
									@(PnlSummary.Value.ROIvsPeakCapital(TxSettlements??[]).ToString("N2")+"%")
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									ROI (vs Average Capital) (18=15/AverageCapital)
								</td>
								<td class="text-end fw-semibold">
									@(PnlSummary.Value.ROIvsAverageCapital(TxSettlements??[]).ToString("N2")+"%")
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold text-danger">
									Unsettled P/L (* @PortfolioUtils.FormatValueWithScale(TotalMarketValue, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
								<td class="text-end fw-semibold text-danger">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.NetPnL+TotalMarketValue, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold text-danger">
									Unsettled ROI (vs Total Buy)
								</td>
								<td class="text-end fw-semibold text-danger">
									@(PnlSummary.Value.UnsettledROIvsTotalBuy(PnlSummary.Value.NetPnL+TotalMarketValue).ToString("N2")+"%")
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold text-danger">
									Unsettled ROI (vs Peak Capital)
								</td>
								<td class="text-end fw-semibold text-danger">
									@(PnlSummary.Value.UnsettledROIvsPeakCapital(PnlSummary.Value.NetPnL+TotalMarketValue, TxSettlements??[]).ToString("N2")+"%")
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold text-danger">
									Unsettled ROI (vs Average Capital)
								</td>
								<td class="text-end fw-semibold text-danger">
									@(PnlSummary.Value.UnsettledROIvsAverageCapital(PnlSummary.Value.NetPnL+TotalMarketValue, TxSettlements??[]).ToString("N2")+"%")
								</td>
							</tr>

							<tr>
								<td class="text-start fs-5 fw-semibold" colspan="2">
									H. Wallet Reconciliation
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Total "In"
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalMoneyIn, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Total "Out"
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(PnlSummary.Value.TotalMoneyOut, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
							<tr>
								<td class="text-start fw-semibold">
									Calculated Closing Balance
								</td>
								<td class="text-end fw-semibold">
									@(PortfolioUtils.FormatValueWithScale(
										PnlSummary.Value.TotalCashIn
										-PnlSummary.Value.TotalCashOut
										-PnlSummary.Value.TotalBuyValue
										+PnlSummary.Value.TotalSellValue
										+PnlSummary.Value.TotalDividends
										+PnlSummary.Value.TotalInterest
										-PnlSummary.Value.TotalFees
										-PnlSummary.Value.TotalTax, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
							</tr>
						</table>
					</div>
				</div>
			</div>
		</div>
	}
</div>

@code {
}
