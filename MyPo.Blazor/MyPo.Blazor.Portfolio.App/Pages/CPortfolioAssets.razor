@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Blazor.Portfolio.App.Pages.Widgets
@using MyPo.Portfolio.Shared.Api
@using MyPo.Portfolio.Shared.Models

@inherits CBase

@* <NavigationLock ConfirmExternalNavigation="false" OnBeforeInternalNavigation="()=>StopRefreshQuotesBackground()" /> *@

<div class="container mt-3">
	@if (Assets == null || Assets.Count() == 0)
	{
		<CAlert Type="warning">
			No assets found. Settle buy/sell transactions to update the asset list.
		</CAlert>
	}
	else
	{
		<CAlert @ref="@Alert" />
		<div class="row mb-2">
			<div class="col-12">
				<div class="card text-bg-light">
					<div class="card-body">
						<table class="table table-sm table-borderless" style="margin-bottom: 0 !important; padding-bottom: 0 !important;">
							<tr>
								<td class="fs-5 fw-semibold">
									Total Cost:
									@(DefaultMarket?.CurrencySymbol??"")
									@(TotalCost<=0?"-":PortfolioUtils.FormatValueWithScale(TotalCost, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
								<td class="fs-5 fw-semibold @(TotalCost<=0||TotalMarketValue<=0?"":(TotalCost<=TotalMarketValue?"text-success":"text-danger"))">
									Market Value:
									@(DefaultMarket?.CurrencySymbol??"")
									@(TotalMarketValue<=0?"-":PortfolioUtils.FormatValueWithScale(TotalMarketValue, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
								</td>
								<td class="fs-5 fw-semibold @(TotalCost<=0||TotalMarketValue<=0?"":(TotalCost<=TotalMarketValue?"text-success":"text-danger"))">
									Unsettled P/L:
									@(DefaultMarket?.CurrencySymbol??"")
									@(TotalCost<=0||TotalMarketValue<=0?"-":PortfolioUtils.FormatValueWithScale(TotalMarketValue-TotalCost, DefaultMarket?.PriceScale??1, DefaultMarket?.ValueFormat??""))
									(@(
										TotalCost>0&&TotalMarketValue>0
											? ((TotalMarketValue-TotalCost)/TotalCost*100).ToString("N2")+"%"
											: "-"
									))
								</td>
							</tr>
						</table>
					</div>
				</div>
			</div>
		</div>

		<div class="row mb-2">
			<div class="col-12">
				<table class="table table-sm table-bordered table-striped table-hover">
					<thead>
						<tr>
							<th scope="col" class="text-center w-auto">Item</th>
							<th scope="col" class="text-center w-auto">Avg. Price</th>
							<th scope="col" class="text-center w-auto">Units</th>
							<th scope="col" class="text-center w-auto">Market Price</th>
							<th scope="col" class="text-center w-auto">Unsettled P/L %</th>
							<th scope="col" class="text-center w-auto">Tags</th>
							<th scope="col" class="text-center w-auto">Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var asset in Assets)
						{
							<tr>
								<td class="text-start w-auto">
									<BIcon icon="@(asset.ItemType==AssetEntity.ASSET_TYPE_STOCK?"cash-stack":"wallet")" />
									@(asset.ItemCode)
								</td>
								<td class="text-end w-auto">
									@(asset.Market?.CurrencySymbol??"")
									@(PortfolioUtils.FormatValueWithScale(asset.AveragePrice, asset.Market?.PriceScale??1, asset.Market?.ValueFormat??""))
								</td>
								<td class="text-end w-auto">
									@(asset.Quantity.ToString(asset.Market?.QuantityFormat??"N2"))
								</td>
								<td class="text-end w-auto">
									<span class="@(asset.Quantity<=0?"":(UnsettledPnLMap.TryGetValue(asset.Id, out var upnl1346)&&upnl1346>=0?"text-success":"text-danger"))">
										@(asset.Market?.CurrencySymbol??"")
										@(LatestPricesMap.TryGetValue(asset.Id, out var lp0762)
											? $"{PortfolioUtils.FormatValueWithScale(lp0762, asset.Market?.PriceScale??1, asset.Market?.ValueFormat??"")}"
											: "-"
										)
									</span>
								</td>
								<td class="text-end w-auto">
									<span class="@(asset.Quantity<=0?"":(UnsettledPnLMap.TryGetValue(asset.Id, out var upnl2272)&&upnl2272>=0?"text-success":"text-danger"))">
										@(asset.Market?.CurrencySymbol??"")
										@(PortfolioUtils.FormatValueWithScale(UnsettledPnLMap.TryGetValue(asset.Id, out var upnl1406)?upnl1406:0, asset.Market?.PriceScale??1, asset.Market?.ValueFormat??""))
										(@(asset.Quantity>0&&UnsettledPnLPercentMap.TryGetValue(asset.Id, out var upnlp2699)?upnlp2699.ToString("N2")+"%":"-"))
									</span>
								</td>
								<td class="text-start w-auto">
									@foreach (var tag in asset.TagsList)
									{
										<CRandomBadge Text="@tag" />
									}
								</td>
								<td class="text-center w-auto">
									<button class="btn btn-sm btn-outline-secondary" @onclick="()=>BtnClickAssetBuySellCalculator(asset.Id)">
										<BIcon icon="calculator" />
									</button>
									<button class="btn btn-sm btn-outline-info" @onclick="()=>BtnClickAssetUpdateTags(asset.Id)">
										<BIcon icon="pencil" />
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
	<div class="alert alert-warning" role="alert">
		<span style="font-size: small">@warningMsg</span>
	</div>
</div>

<CModal @ref="@ModalDialogBuySellAssetCalculator" title="Asset Buy/Sell Calculator" centered="false" type="secondary" size="extra-large">
	<nav>
		<div class="nav nav-tabs" id="nav-tab" role="tablist">
			<button class="nav-link active"
				id="tabBuyCalc"
				data-coreui-toggle="tab" data-coreui-target="#nav-buy-calc"
				type="button" role="tab" aria-controls="nav-buy-calc" aria-selected="true">Buy</button>
			<button class="nav-link"
				id="tabSellCalc"
				data-coreui-toggle="tab" data-coreui-target="#nav-sell-calc"
				type="button" role="tab" aria-controls="nav-sell-calc" aria-selected="false">Sells</button>
		</div>
	</nav>
	<div class="tab-content mt-2" id="nav-tabContent">
		<div class="tab-pane fade show active" id="nav-buy-calc" role="tabpanel" aria-labelledby="tabBuyCalc" tabindex="0">
			<WidgetBuyCalculator
				ItemCode="@(SelectedAsset?.ItemCode??"")"
				UnitPrice="@(LatestPricesMap.TryGetValue(SelectedAsset?.Id??"", out var lp4776)?lp4776:100)"
				TxFee="@(PortfolioUtils.EstimateTxFee(SelectedAsset?.Market??null))"
				OwningUnits="@(SelectedAsset?.Quantity??0)"
				OwningAvgPrice="@(SelectedAsset?.AveragePrice??0)" />
		</div>
		<div class="tab-pane fade" id="nav-sell-calc" role="tabpanel" aria-labelledby="tabSellCalc" tabindex="0">
			<WidgetSellCalculator
				ItemCode="@(SelectedAsset?.ItemCode??"")"
				UnitPrice="@(LatestPricesMap.TryGetValue(SelectedAsset?.Id??"", out var lp9551)?lp9551:80)"
				TxFee="@(PortfolioUtils.EstimateTxFee(SelectedAsset?.Market??null))"
				NumUnits="@(SelectedAsset?.Quantity??10)"
				OwningAvgPrice="@(SelectedAsset?.AveragePrice??100)" />
		</div>
	</div>
</CModal>

<CModal @ref="@ModalDialogAssetUpdateTags" title="Asset Info" centered="false" type="info" size="extra-large">
	<div class="card mb-2">
		<div class="card-body">
			<CAlert @ref="@ModalDialogAssetUpdateTags.Alert" />
			@if (SelectedAsset != null)
			{
				<div class="row card-group">
					<div class="col-md-6 col-sm-12">
						<div class="card mb-2 border-top-info border-top-3">
							<div class="card-body">
    							<h5 class="card-title">@(SelectedAsset.ItemCode)</h5>
								<table class="table table-sm table-borderless" style="margin-bottom: 0 !important; padding-bottom: 0 !important;">
									<tr>
										<td>
											Type:
										</td>
										<td class="text-end">
											@(SelectedAsset.ItemType)
										</td>
									</tr>
									<tr>
										<td>
											Position:
										</td>
										<td class="text-end">
											@(SelectedAsset.Quantity.ToString(SelectedAsset.Market?.QuantityFormat??"N2"))
										</td>
									</tr>
									<tr>
										<td>
											Average Price:
										</td>
										<td class="text-end">
											@(SelectedAsset.Market?.CurrencySymbol??"")
											@(PortfolioUtils.FormatValueWithScale(SelectedAsset.AveragePrice, SelectedAsset.Market?.PriceScale??1, SelectedAsset.Market?.ValueFormat??""))
										</td>
									</tr>
									<tr>
										<td>
											Total Cost:
										</td>
										<td class="text-end">
											@(SelectedAsset.Market?.CurrencySymbol??"")
											@(PortfolioUtils.FormatValueWithScale(SelectedAsset.TotalCost, SelectedAsset.Market?.PriceScale??1, SelectedAsset.Market?.ValueFormat??""))
										</td>
									</tr>
								</table>
							</div>
						</div>
					</div>
					<div class="col-md-6 col-sm-12">
						<div class="card mb-2 @(new List<string>(["border-top-danger", "border-top-primary", "border-top-success"])[MarketStatus(SelectedAsset)+1]) border-top-3">
							<div class="card-body">
    							<h5 class="card-title">Performance</h5>
								<table class="table table-sm table-borderless" style="margin-bottom: 0 !important; padding-bottom: 0 !important;">
									<tr>
										<td>
											Market:
										</td>
										<td class="text-end">
											@(SelectedAsset.Market?.Country??"-") / @(SelectedAsset.Market?.Code??"-")
											(@((SelectedAsset.Market?.ToModel().IsCurrentlyOpen() == true ? "Open" : "Closed") ?? "-"))
										</td>
									</tr>
									@*
									<tr>
										<td>
											Status:
										</td>
										<td class="text-end">
											@((SelectedAsset.Market?.ToModel().IsCurrentlyOpen() == true ? "Market Open" : "Market Closed") ?? "-")
										</td>
									</tr>
									*@
									<tr>
										<td>
											Unsettled P/L:
										</td>
										<td class="text-end @(new List<string>(["text-danger", "", "text-success"])[MarketStatus(SelectedAsset)+1])">
											@(SelectedAsset.Market?.CurrencySymbol??"")
											@(UnsettledPnLMap.TryGetValue(SelectedAsset.Id, out var upnl2520)
												? $"{PortfolioUtils.FormatValueWithScale(upnl2520, SelectedAsset.Market?.PriceScale??1, SelectedAsset.Market?.ValueFormat??"")}"
												: "-"
											)
										</td>
									</tr>
									<tr>
										<td>
											Market Price:
										</td>
										<td class="text-end @(new List<string>(["text-danger", "", "text-success"])[MarketStatus(SelectedAsset)+1])">
											@(SelectedAsset.Market?.CurrencySymbol??"")
											@(LatestPricesMap.TryGetValue(SelectedAsset.Id, out var lp7990)
												? $"{PortfolioUtils.FormatValueWithScale(lp7990, SelectedAsset.Market?.PriceScale??1, SelectedAsset.Market?.ValueFormat??"")}"
												: "-"
											)
											(@(SelectedAsset.Quantity>0&&UnsettledPnLPercentMap.TryGetValue(SelectedAsset.Id, out var upnl0763)?upnl0763.ToString("N2")+"%":"-"))
										</td>
									</tr>
									<tr>
										<td>
											Market Value:
										</td>
										<td class="text-end @(new List<string>(["text-danger", "", "text-success"])[MarketStatus(SelectedAsset)+1])">
											@(SelectedAsset.Quantity<=0
												? "-"
												: (SelectedAsset.Market?.CurrencySymbol??"") + " " +
												  PortfolioUtils.FormatValueWithScale(
													LatestPricesMap.TryGetValue(SelectedAsset.Id, out var lp7317)
														? lp7317 * SelectedAsset.Quantity
														: 0,
													SelectedAsset.Market?.PriceScale??1,
													SelectedAsset.Market?.ValueFormat??""
												  )
											)
										</td>
									</tr>
								</table>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="input-group input-group-sm">
						<span class="input-group-text">Tags:</span>
						<input type="text" class="form-control" @bind="AssetTags" placeholder="Comma separated, e.g. ETF, Divident,..."/>
						<button class="btn btn-outline-primary" type="button" @onclick="()=>BtnClickAssetUpdateTagsConfirmed()">Update</button>
					</div>
				</div>
			}
		</div>
	</div>
	<div class="alert alert-warning" role="alert">
		<span style="font-size: small">@warningMsg</span>
	</div>
</CModal>

@code {
	private string warningMsg = "Stock chart and data are provided by third-party services. " +
		"The application does not guarantee the accuracy, completeness, or timeliness of the information displayed. " +
		"Users should verify the data independently before making any investment decisions.";
}
