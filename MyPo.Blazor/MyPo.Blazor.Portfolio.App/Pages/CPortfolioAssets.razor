@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Portfolio.Shared.Api

@inherits CBase

@if (!string.IsNullOrEmpty(AlertMessage))
{
	<CAlert type="@AlertType">
		@AlertMessage
	</CAlert>
}

@* <NavigationLock ConfirmExternalNavigation="false" OnBeforeInternalNavigation="()=>StopRefreshQuotesBackground()" /> *@

<div class="container mt-3">
	<table class="table table-sm table-bordered border-primary table-striped table-hover align-middle">
		<thead>
			<tr>
				<th scope="col" class="text-center w-auto">Type</th>
				<th scope="col" class="text-center w-auto">Code</th>
				<th scope="col" class="text-center w-auto">Exchange</th>
				<th scope="col" class="text-center w-auto">Quantity</th>
				<th scope="col" class="text-center w-auto">Average Price</th>
				<th scope="col" class="text-center w-auto">Latest Price</th>
				<th scope="col" class="text-center w-auto" colspan="2">Unsettled P/L</th>
				<th scope="col" class="text-center">Tags</th>
				<th scope="col" class="text-center w-auto">Actions</th>
			</tr>
		</thead>
		<tbody>
			@if (Assets == null || Assets.Count() == 0)
			{
				<tr>
					<td colspan="9" class="text-center">No assets found. Settle transactions to update the asset list.</td>
				</tr>
			}
			else
			{
				@foreach (var asset in Assets)
				{
					<tr>
						<td class="text-center w-auto">@(asset.ItemType)</td>
						<td class="text-center w-auto">@(asset.ItemCode)</td>
						<td class="text-center w-auto">@(asset.MarketId??"-") / @(asset.Market?.CurrencySymbol??"-")</td>
						<td class="text-end w-auto">@(asset.Quantity.ToString("N2"))</td>
						<td class="text-end w-auto">@(PortfolioUtils.FormatValueWithScale(asset.AveragePrice, asset.Market?.PriceScale??1))</td>
						<td class="text-end w-auto">
							<span class="@(UnsettledPnLMap.TryGetValue(asset.Id, out var p0)&&p0>=0?"text-success":"text-danger")">
								@(LatestPricesMap.TryGetValue(asset.Id, out var lp)?PortfolioUtils.FormatValueWithScale(lp, asset.Market?.PriceScale??1):"⌛")
							</span>
						</td>
						<td class="text-end w-auto">
							<span class="@(UnsettledPnLMap.TryGetValue(asset.Id, out var p1)&&p1>=0?"text-success":"text-danger")">
								@(UnsettledPnLMap.TryGetValue(asset.Id, out var pl)?PortfolioUtils.FormatValueWithScale(pl, asset.Market?.PriceScale??1):"⌛")
							</span>
						</td>
						<td class="text-end w-auto">
							<span class="@(UnsettledPnLMap.TryGetValue(asset.Id, out var p2)&&p2>=0?"text-success":"text-danger")">
								@(UnsettledPnLPercentMap.TryGetValue(asset.Id, out var plp)?plp.ToString("N2")+"%":"-")
							</span>
						</td>
						<td class="text-center">
							@foreach(var tag in asset.TagsList)
							{
								<CRandomBadge Text="@tag" />
							}
						</td>
						<td class="text-center w-auto">
							<button class="btn btn-sm btn-outline-info" title="Details" @onclick="(()=>BtnClickAssetInfo(asset.Id))">
								<CIcon icon="cil-info" />
							</button>
						</td>
					</tr>
				}
			}
		</tbody>
		<tfoot>
			<tr>
				<th colspan="3" class="text-center">
					Total Cost / Market Value:
				</th>
				<th colspan="2" class="text-center">
					@(PortfolioUtils.FormatValueWithScale(TotalCost, DefaultMarket?.PriceScale??1))
				</th>
				<th colspan="2" class="text-center">
					<span class="@(TotalCost<TotalMarketValue?"text-success":"text-danger")">
						@(PortfolioUtils.FormatValueWithScale(TotalMarketValue, DefaultMarket?.PriceScale??1))
						(@(
							TotalCost!=0
								? ((TotalMarketValue-TotalCost)/TotalCost*100).ToString("N2")+"%"
								: "-"
						))
					</span>
				</th>
				<th colspan="2">&nbsp;</th>
			</tr>
		</tfoot>
	</table>
	<div class="alert alert-warning" role="alert">
		<span style="font-size: small">@warningMsg</span>
	</div>
</div>

<CModal @ref="@ModalDialogAssetInfo" title="Asset Details" centered="false" type="info" size="extra-large">
	<div class="card mb-2">
		<div class="card-body">
			@if (!string.IsNullOrEmpty(AlertMessage))
			{
				<CAlert type="@AlertType">
					@AlertMessage
				</CAlert>
			}
			<table class="table @*table-bordered*@ border-secondary align-middle">
				<tbody>
					<tr>
						<td class="text-center w-auto">@(SelectedAsset?.ItemType)</td>
						<td class="text-center w-auto">@(SelectedAsset?.ItemCode)</td>
						<td class="text-center w-auto">@(SelectedMarket==null?"-":SelectedMarket.Id.ToUpper()+(SelectedMarket.IsCurrentlyOpen()?" (Market Open)":" (Market Close)"))</td>
						<td class="text-center w-auto">@(SelectedAsset?.Market?.Currency??"-")</td>
						<td class="text-center w-auto">
							@(SelectedAsset?.Quantity.ToString("N2"))
							@@
							@(PortfolioUtils.FormatValueWithScale(SelectedAsset?.AveragePrice??0, SelectedAsset?.Market?.PriceScale??1))
							/
							<span class="@(UnsettledPnLMap.TryGetValue(SelectedAsset?.Id??"", out var p0)&&p0>=0?"text-success":"text-danger")">
								@(LatestPricesMap.TryGetValue(SelectedAsset?.Id??"", out var q0)
									? $"{PortfolioUtils.FormatValueWithScale(q0, SelectedAsset?.Market?.PriceScale??1)}"
									: "-"
								)
								(@(UnsettledPnLPercentMap.TryGetValue(SelectedAsset?.Id??"", out var plp)?plp.ToString("N2")+"%":"-"))
							</span>

						</td>
						<td class="col-3">
							<div class="input-group input-group-sm">
								<span class="input-group-text">Tags:</span>
								<input type="text" class="form-control" @bind="AssetTags" placeholder="Comma separated, e.g. ETF, Divident,..."/>
								<button class="btn btn-outline-primary" type="button" @onclick="()=>BtnClickUpdateAssetTags()">Update</button>
							</div>
						</td>
					</tr>
				</tbody>
			</table>
			@if (SelectedAsset?.ItemType == "STOCK")
			{
				<CStockChart Market="@SelectedAsset?.Market?.ToModel()" Symbol="@SelectedAsset?.ItemCode" />
			}
		</div>
	</div>
	<div class="alert alert-warning" role="alert">
		<span style="font-size: small">@warningMsg</span>
	</div>
</CModal>

@code {
	private string warningMsg = "Stock chart and data are provided by third-party services. " +
		"The application does not guarantee the accuracy, completeness, or timeliness of the information displayed. " +
		"Users should verify the data independently before making any investment decisions.";
}
