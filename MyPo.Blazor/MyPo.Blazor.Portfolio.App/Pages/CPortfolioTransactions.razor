@using MyPo.Blazor.App.Shared
@using MyPo.Portfolio.Shared.Api

@inherits BaseComponent

<div class="container mt-3">
	<button class="btn btn-primary btn-sm mb-3" @onclick="BtnClickAddTx"><CIcon icon="cil-plus" /> Add Transaction</button>
	<table class="table table-sm table-bordered border-primary table-striped table-hover align-middle">
		<thead>
			<tr>
				<th scope="col" class="text-center">Type</th>
				<th scope="col" class="text-center">Time</th>
				<th scope="col" class="text-center">Item</th>
				<th scope="col" class="text-center">Quantity</th>
				<th scope="col" class="text-center">Price</th>
				<th scope="col" class="text-center">Tx Fee</th>
				<th scope="col" class="text-center">Tax</th>
				<th scope="col" class="text-center">Cost (other)</th>
			</tr>
		</thead>
		@if (Transactions == null || Transactions.Count() == 0)
		{
			<tbody>
				<tr>
					<td colspan="8" class="text-center">No data found.</td>
				</tr>
			</tbody>
		}
	</table>
</div>

<CModal @ref="@ModalDialogAddTx" title="Record A New Transaction" centered="false" type="primary" size="extra-large">
	<div class="card">
		<div class="card-body">
			<form>
				<div class="row mb-3 align-items-center">
					<div class="col-4">
						<div class="form-floating">
							<select class="form-select" id="txType" aria-label="Buy/Sell" @bind="TxType">
								<option value="Buy">Buy</option>
								<option value="Sell">Sell</option>
							</select>
							<label for="txType">Buy/Sell:</label>
						</div>
					</div>
					<div class="col-4">
						<div class="form-floating">
							<select class="form-select" id="txMarket" aria-label="Market" @bind="TxMarket">
								@foreach (var m in Markets ?? [])
								{
									<option value="@m.Id">@m.Code (@m.Name - @m.Country)</option>
								}
							</select>
							<label for="txMarket">Market:</label>
						</div>
					</div>
					<div class="col-4">
						<div>
							<label for="txTime">Transaction Time:</label>
							<div class="input-group input-group-sm">
								<input type="text" class="form-control" id="txTime" placeholder="Transaction Time" value="@TxTime" data-datetime-picker="true"/>
								<span class="input-group-text"><CIcon icon="calendar"/></span>
							</div>
						</div>
					</div>

					@* <script type="text/javascript">
						(function () {
							console.log("Initializing datetime picker...");
							const elements = document.querySelectorAll('[data-datetime-picker="true"]');
							for (let i = 0; i < elements.length; i++) {
								console.log(elements[i]);
							}
						})();
					</script> *@
				</div>

				<div class="row">
					<div class="col-8">
						<div class="form-floating mb-1">
							<input type="text" class="form-control" id="pName" placeholder="Name" disabled value="(SelectedPortfolio?.Name)">
							<label for="pName">Name</label>
						</div>
					</div>
					<div class="col-4">
						<div class="form-floating mb-1">
							<input type="text" class="form-control" id="pCurrency" placeholder="Currency" disabled value="(SelectedPortfolio?.Currency)">
							<label for="pCurrency">Currency</label>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-sm-12">
						<div class="form-floating mb-1">
							<textarea class="form-control form-control-sm" id="pDesc" placeholder="Décription" disabled style="height: 100px;">(SelectedPortfolio?.Description)</textarea>
							<label for="pDesc">Description</label>
						</div>
					</div>
				</div>
			</form>
			<hr />
			@* <button type="button" class="btn btn-secondary" @onclick="() => ModalDialogDelete.Close()"><CIcon icon="x-circle" /> Cancel</button> *@
			@* <button type="button" class="btn btn-danger" @onclick="() => BtnClickDeleteConfirm()"><CIcon icon="x" /> Delete</button> *@
		</div>
	</div>
</CModal>

