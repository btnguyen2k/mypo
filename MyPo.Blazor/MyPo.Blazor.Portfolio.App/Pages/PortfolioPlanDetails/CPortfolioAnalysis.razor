@using System.Globalization
@using FinHub.Client.Models.AI
@using FinHub.Client.Models.Portfolios
@using MyPo.Blazor.App.Shared

@inject NavigationManager NavigationManager

<style>
    .portfolio-analysis summary {
        cursor: pointer;
    }

    .portfolio-analysis .analysis-copy {
        white-space: pre-line;
    }

    .portfolio-analysis .analysis-highlight {
        background: var(--cui-tertiary-bg, var(--bs-tertiary-bg));
    }

    .portfolio-analysis .analysis-reference:target {
        background: var(--cui-highlight-bg, var(--bs-highlight-bg));
        scroll-margin-top: 1rem;
    }

    @@media print {
        .portfolio-analysis details > * {
            display: block !important;
        }
    }
</style>

<div class="portfolio-analysis">
    @if (Analysis is PortfolioReview review)
    {
        <div class="card @ReviewStatusBorderClass(review.ReviewStatus) mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="text-uppercase text-muted small mb-2">Portfolio review</div>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge @ReviewStatusBadgeClass(review.ReviewStatus)">
                            @ReviewStatusLabel(review.ReviewStatus)
                        </span>
                        <span class="badge text-bg-primary">@StrategyLabel(review.Strategy)</span>
                        <span class="badge @DataQualityBadgeClass(review.OverallDataQuality)">
                            @DataQualityLabel(review.OverallDataQuality) data quality
                        </span>
                        <span class="badge @(review.RebalanceRequested ? "text-bg-info" : "text-bg-secondary")">
                            @(review.RebalanceRequested ? "Rebalance requested" : "Review only")
                        </span>
                        <span class="badge @RebalanceBadgeClass(review.RebalanceRecommended)">
                            @RebalanceLabel(review.RebalanceRecommended)
                        </span>
                    </div>
                </div>
                <div class="small text-muted text-md-end">
                    <BIcon icon="bi-clock" extraClassName="me-1" />
                    Analysis as of @FormatTimestamp(review.AsOf)
                </div>
            </div>
        </div>
    }
    else if (Analysis is PortfolioConstruction construction)
    {
        <div class="card @ConstructionStatusBorderClass(construction.ConstructionStatus) mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="text-uppercase text-muted small mb-2">Portfolio construction</div>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge @ConstructionStatusBadgeClass(construction.ConstructionStatus)">
                            @ConstructionStatusLabel(construction.ConstructionStatus)
                        </span>
                        <span class="badge text-bg-primary">@ConstructionModeLabel(construction.ConstructionMode)</span>
                        <span class="badge @DataQualityBadgeClass(construction.OverallDataQuality)">
                            @DataQualityLabel(construction.OverallDataQuality) data quality
                        </span>
                    </div>
                </div>
                <div class="small text-muted text-md-end">
                    <BIcon icon="bi-clock" extraClassName="me-1" />
                    Analysis as of @FormatTimestamp(construction.AsOf)
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <BIcon icon="bi-exclamation-triangle" extraClassName="me-1" />
            Unsupported portfolio analysis result: @Analysis.ResultType
        </div>
    }

    @if (IsSupportedAnalysis)
    {
        @if (ValidationWarnings.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <div class="fw-semibold mb-2">
                    <BIcon icon="bi-exclamation-triangle" extraClassName="me-1" />
                    Validation warnings
                </div>
                <ul class="mb-0 ps-3">
                    @foreach (var warning in ValidationWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        @if (Analysis is PortfolioReview reviewAnalysis)
        {
            <section class="card mb-4" aria-labelledby="portfolio-review-summary">
                <div class="card-body">
                    <h5 id="portfolio-review-summary">
                        <BIcon icon="bi-card-text" extraClassName="me-1" />
                        Analysis summary
                    </h5>
                    <div class="analysis-copy">@reviewAnalysis.Summary</div>
                    @if (IsPresent(reviewAnalysis.InvestorTheme))
                    {
                        <details class="mt-3">
                            <summary class="small text-muted">Investor theme</summary>
                            <div class="analysis-copy small mt-2">@reviewAnalysis.InvestorTheme</div>
                        </details>
                    }
                </div>
            </section>

            <section class="mb-4" aria-labelledby="portfolio-review-metrics">
                <h5 id="portfolio-review-metrics" class="mb-3">
                    <BIcon icon="bi-speedometer2" extraClassName="me-1" />
                    Portfolio metrics
                </h5>
                <div class="row g-3">
                    <div class="col-sm-6 col-xl">
                        <div class="card h-100 border-start border-start-4 border-start-info">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Market value</div>
                                <div class="h5 mb-0">@FormatAmount(reviewAnalysis.Snapshot.TotalMarketValue, reviewAnalysis.Snapshot.Currency)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="card h-100 border-start border-start-4 border-start-primary">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Holdings reviewed</div>
                                <div class="h5 mb-0">@reviewAnalysis.HoldingReviews.Count</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="card h-100 border-start border-start-4 border-start-warning">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Target turnover</div>
                                <div class="h5 mb-0">@FormatRatio(reviewAnalysis.TargetTurnover)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="card h-100 border-start border-start-4 border-start-secondary">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Market</div>
                                <div class="h5 mb-0">@ValueOrPlaceholder(reviewAnalysis.Country)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="card h-100 border-start border-start-4 border-start-success">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Budget</div>
                                <div class="h5 mb-1">@FormatBudget(reviewAnalysis.Budget)</div>
                                @if (reviewAnalysis.Budget.IsInferred)
                                {
                                    <span class="badge text-bg-info">Inferred</span>
                                }
                                @if (IsPresent(reviewAnalysis.Budget.SourceText))
                                {
                                    <div class="small text-muted mt-2">@reviewAnalysis.Budget.SourceText</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @if (reviewAnalysis.Strengths.Count > 0)
            {
                <section class="mb-4" aria-labelledby="portfolio-review-strengths">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 id="portfolio-review-strengths" class="mb-0">
                            <BIcon icon="bi-shield-check" extraClassName="me-1" />
                            Strengths
                        </h5>
                        <span class="badge text-bg-success">@reviewAnalysis.Strengths.Count</span>
                    </div>
                    <div class="d-grid gap-3">
                        @foreach (var strength in reviewAnalysis.Strengths)
                        {
                            <article class="card border-start border-start-4 border-start-success">
                                <div class="card-body">
                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                        <h6 class="mb-0">@strength.Title</h6>
                                        <span class="small text-muted">@ClampConfidence(strength.Confidence)% confidence</span>
                                    </div>
                                    <div class="analysis-copy">@strength.Analysis</div>

                                    @if (strength.AffectedTickers.Any(IsPresent))
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                            <span class="small text-muted">Affected:</span>
                                            @foreach (var ticker in strength.AffectedTickers.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase))
                                            {
                                                <span class="badge text-bg-light border">@ticker</span>
                                            }
                                        </div>
                                    }

                                    @if (strength.ReferenceIds.Any(IsPresent))
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                            <span class="small text-muted">Sources:</span>
                                            @foreach (var referenceId in strength.ReferenceIds.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase))
                                            {
                                                var referenceIndex = FindReferenceIndex(referenceId);
                                                if (referenceIndex >= 0)
                                                {
                                                    <a href="@ReferenceHref(referenceIndex)"
                                                       class="badge text-bg-light border text-decoration-none"
                                                       title="@References[referenceIndex].Title">
                                                        [@(referenceIndex + 1)]
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-warning" title="Reference was not included in the analysis response">
                                                        @referenceId
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }

                                    @if (strength.DataGaps.Any(IsPresent))
                                    {
                                        <details class="mt-3">
                                            <summary class="small text-muted">Strength data limitations</summary>
                                            <ul class="small mb-0 mt-2 ps-3">
                                                @foreach (var gap in strength.DataGaps.Where(IsPresent))
                                                {
                                                    <li>@gap</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (reviewAnalysis.Risks.Count > 0)
            {
                <section class="mb-4" aria-labelledby="portfolio-review-risks">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 id="portfolio-review-risks" class="mb-0">
                            <BIcon icon="bi-shield-exclamation" extraClassName="me-1" />
                            Risks
                        </h5>
                        <span class="badge text-bg-danger">@reviewAnalysis.Risks.Count</span>
                    </div>
                    <div class="d-grid gap-3">
                        @foreach (var risk in reviewAnalysis.Risks)
                        {
                            <article class="card border-start border-start-4 @RiskBorderClass(risk.Level)">
                                <div class="card-body">
                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                        <span class="badge @RiskBadgeClass(risk.Level)">@RiskLevelLabel(risk.Level)</span>
                                        <span class="small text-muted">@ClampConfidence(risk.Confidence)% confidence</span>
                                    </div>

                                    <h6>@risk.Risk</h6>

                                    <div class="row g-3 mt-1">
                                        <div class="col-lg-6">
                                            <div class="analysis-highlight rounded p-3 h-100">
                                                <div class="small text-uppercase text-muted fw-semibold mb-1">Impact</div>
                                                <div class="analysis-copy">@risk.Impact</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="analysis-highlight rounded p-3 h-100">
                                                <div class="small text-uppercase text-muted fw-semibold mb-1">Mitigation</div>
                                                <div class="analysis-copy">@risk.Mitigation</div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (risk.AffectedTickers.Any(IsPresent))
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                            <span class="small text-muted">Affected:</span>
                                            @foreach (var ticker in risk.AffectedTickers.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase))
                                            {
                                                <span class="badge text-bg-light border">@ticker</span>
                                            }
                                        </div>
                                    }

                                    @if (risk.ReferenceIds.Any(IsPresent))
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                            <span class="small text-muted">Sources:</span>
                                            @foreach (var referenceId in risk.ReferenceIds.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase))
                                            {
                                                var referenceIndex = FindReferenceIndex(referenceId);
                                                if (referenceIndex >= 0)
                                                {
                                                    <a href="@ReferenceHref(referenceIndex)"
                                                       class="badge text-bg-light border text-decoration-none"
                                                       title="@References[referenceIndex].Title">
                                                        [@(referenceIndex + 1)]
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-warning" title="Reference was not included in the analysis response">
                                                        @referenceId
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }

                                    @if (risk.DataGaps.Any(IsPresent))
                                    {
                                        <details class="mt-3">
                                            <summary class="small text-muted">Risk data limitations</summary>
                                            <ul class="small mb-0 mt-2 ps-3">
                                                @foreach (var gap in risk.DataGaps.Where(IsPresent))
                                                {
                                                    <li>@gap</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (reviewAnalysis.HoldingReviews.Count > 0)
            {
                <section class="mb-4" aria-labelledby="portfolio-holding-reviews">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 id="portfolio-holding-reviews" class="mb-0">
                            <BIcon icon="bi-clipboard-data" extraClassName="me-1" />
                            Holding reviews
                        </h5>
                        <span class="badge text-bg-secondary">@reviewAnalysis.HoldingReviews.Count</span>
                    </div>
                    <div class="d-grid gap-3">
                        @foreach (var holding in reviewAnalysis.HoldingReviews.OrderBy(holding => holding.Ticker, StringComparer.OrdinalIgnoreCase))
                        {
                            <details class="card">
                                <summary class="card-header">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <span class="fw-semibold">@holding.Ticker</span>
                                            @if (IsPresent(holding.CompanyName))
                                            {
                                                <span class="text-muted ms-1">@holding.CompanyName</span>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="badge @HoldingRecommendationBadgeClass(holding.Recommendation)">
                                                @HoldingRecommendationLabel(holding.Recommendation)
                                            </span>
                                            <span class="small text-muted">@ClampConfidence(holding.Confidence)% confidence</span>
                                        </div>
                                    </div>
                                </summary>
                                <div class="card-body">
                                    <div class="row g-3 mb-3">
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="small text-uppercase text-muted">Current</div>
                                            <div class="fw-semibold">@FormatRatio(holding.CurrentAllocation)</div>
                                        </div>
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="small text-uppercase text-muted">Target</div>
                                            <div class="fw-semibold">@FormatRatio(holding.TargetAllocation)</div>
                                        </div>
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="small text-uppercase text-muted">Change</div>
                                            <div class="fw-semibold @SignedValueClass(holding.TargetAllocation - holding.CurrentAllocation)">
                                                @FormatPercentagePointChange(holding.TargetAllocation - holding.CurrentAllocation)
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-lg-3">
                                            <div class="small text-uppercase text-muted">Role</div>
                                            <div class="fw-semibold">@ValueOrPlaceholder(holding.Role)</div>
                                        </div>
                                    </div>

                                    <div class="analysis-highlight rounded p-3 mb-3">
                                        <div class="small text-uppercase text-muted fw-semibold mb-1">Investment thesis</div>
                                        <div class="analysis-copy">@holding.Thesis</div>
                                    </div>

                                    @if (holding.ExitReason is not null)
                                    {
                                        <div class="alert alert-danger py-2">
                                            <span class="fw-semibold">Exit reason:</span> @ExitReasonLabel(holding.ExitReason.Value)
                                        </div>
                                    }

                                    <div class="row g-3">
                                        @if (holding.Strengths.Any(IsPresent))
                                        {
                                            <div class="col-lg-6">
                                                <div class="fw-semibold text-success mb-2">Strengths</div>
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var strength in holding.Strengths.Where(IsPresent))
                                                    {
                                                        <li>@strength</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        @if (holding.Risks.Any(IsPresent))
                                        {
                                            <div class="col-lg-6">
                                                <div class="fw-semibold text-danger mb-2">Risks</div>
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var risk in holding.Risks.Where(IsPresent))
                                                    {
                                                        <li>@risk</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>

                                    @if (holding.ReferenceIds.Any(IsPresent))
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                            <span class="small text-muted">Sources:</span>
                                            @foreach (var referenceId in holding.ReferenceIds.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase))
                                            {
                                                var referenceIndex = FindReferenceIndex(referenceId);
                                                if (referenceIndex >= 0)
                                                {
                                                    <a href="@ReferenceHref(referenceIndex)"
                                                       class="badge text-bg-light border text-decoration-none"
                                                       title="@References[referenceIndex].Title">
                                                        [@(referenceIndex + 1)]
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-warning" title="Reference was not included in the analysis response">
                                                        @referenceId
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }

                                    @if (holding.DataGaps.Any(IsPresent))
                                    {
                                        <details class="mt-3">
                                            <summary class="small text-muted">Holding data limitations</summary>
                                            <ul class="small mb-0 mt-2 ps-3">
                                                @foreach (var gap in holding.DataGaps.Where(IsPresent))
                                                {
                                                    <li>@gap</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </section>
            }

            @if (reviewAnalysis.TargetPortfolio.Count > 0)
            {
                <section class="mb-4" aria-labelledby="portfolio-review-target">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 id="portfolio-review-target" class="mb-0">
                            <BIcon icon="bi-bullseye" extraClassName="me-1" />
                            Target portfolio
                        </h5>
                        <span class="badge text-bg-secondary">@reviewAnalysis.TargetPortfolio.Count</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Ticker</th>
                                    <th class="text-end">Current</th>
                                    <th class="text-end">Target</th>
                                    <th class="text-end">Change</th>
                                    <th>Role and rationale</th>
                                    <th>Sources</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                @foreach (var position in reviewAnalysis.TargetPortfolio.OrderByDescending(position => position.TargetAllocation))
                                {
                                    var change = position.TargetAllocation - position.CurrentAllocation;
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@position.Ticker</div>
                                            @if (IsPresent(position.CompanyName))
                                            {
                                                <div class="small text-muted">@position.CompanyName</div>
                                            }
                                        </td>
                                        <td class="text-end">@FormatRatio(position.CurrentAllocation)</td>
                                        <td class="text-end">@FormatRatio(position.TargetAllocation)</td>
                                        <td class="text-end @SignedValueClass(change)">@FormatPercentagePointChange(change)</td>
                                        <td>
                                            <div class="fw-semibold">@position.Role</div>
                                            <div class="small analysis-copy">@position.Rationale</div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var referenceId in position.ReferenceIds.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase))
                                                {
                                                    var referenceIndex = FindReferenceIndex(referenceId);
                                                    if (referenceIndex >= 0)
                                                    {
                                                        <a href="@ReferenceHref(referenceIndex)"
                                                           class="badge text-bg-light border text-decoration-none"
                                                           title="@References[referenceIndex].Title">
                                                            [@(referenceIndex + 1)]
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-warning">@referenceId</span>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
        else if (Analysis is PortfolioConstruction constructionAnalysis)
        {
            <section class="card mb-4" aria-labelledby="portfolio-construction-summary">
                <div class="card-body">
                    <h5 id="portfolio-construction-summary">
                        <BIcon icon="bi-card-text" extraClassName="me-1" />
                        Construction summary
                    </h5>
                    <div class="analysis-copy">@constructionAnalysis.Summary</div>
                    @if (IsPresent(constructionAnalysis.InvestorTheme))
                    {
                        <details class="mt-3">
                            <summary class="small text-muted">Investor theme</summary>
                            <div class="analysis-copy small mt-2">@constructionAnalysis.InvestorTheme</div>
                        </details>
                    }
                </div>
            </section>

            <section class="mb-4" aria-labelledby="portfolio-construction-metrics">
                <h5 id="portfolio-construction-metrics" class="mb-3">
                    <BIcon icon="bi-speedometer2" extraClassName="me-1" />
                    Construction metrics
                </h5>
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100 border-start border-start-4 border-start-primary">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Target positions</div>
                                <div class="h5 mb-0">@constructionAnalysis.TargetPortfolio.Count</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100 border-start border-start-4 border-start-info">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Verified seed holdings</div>
                                <div class="h5 mb-0">@constructionAnalysis.VerifiedSeedHoldings.Count</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100 border-start border-start-4 border-start-secondary">
                            <div class="card-body">
                                <div class="text-uppercase text-muted small mb-2">Market</div>
                                <div class="h5 mb-0">@ValueOrPlaceholder(constructionAnalysis.Country)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @if (constructionAnalysis.TargetPortfolio.Count > 0)
            {
                <section class="mb-4" aria-labelledby="portfolio-construction-target">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 id="portfolio-construction-target" class="mb-0">
                            <BIcon icon="bi-bullseye" extraClassName="me-1" />
                            Target portfolio
                        </h5>
                        <span class="badge text-bg-secondary">@constructionAnalysis.TargetPortfolio.Count</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Ticker</th>
                                    <th class="text-end">Allocation</th>
                                    <th>Role and rationale</th>
                                    <th>Sources</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                @foreach (var position in constructionAnalysis.TargetPortfolio.OrderByDescending(position => position.Allocation))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@position.Ticker</div>
                                            @if (IsPresent(position.CompanyName))
                                            {
                                                <div class="small text-muted">@position.CompanyName</div>
                                            }
                                        </td>
                                        <td class="text-end">@FormatRatio(position.Allocation)</td>
                                        <td>
                                            <div class="fw-semibold">@position.Role</div>
                                            <div class="small analysis-copy">@position.Rationale</div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var referenceId in position.ReferenceIds.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase))
                                                {
                                                    var referenceIndex = FindReferenceIndex(referenceId);
                                                    if (referenceIndex >= 0)
                                                    {
                                                        <a href="@ReferenceHref(referenceIndex)"
                                                           class="badge text-bg-light border text-decoration-none"
                                                           title="@References[referenceIndex].Title">
                                                            [@(referenceIndex + 1)]
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-warning">@referenceId</span>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }

        @if (CombinedDataGaps.Count > 0)
        {
            <details class="card mb-4">
                <summary class="card-header fw-semibold">
                    <BIcon icon="bi-info-circle" extraClassName="me-1" />
                    Data limitations
                    <span class="badge text-bg-secondary ms-1">@CombinedDataGaps.Count</span>
                </summary>
                <div class="card-body">
                    <ul class="mb-0 ps-3">
                        @foreach (var gap in CombinedDataGaps)
                        {
                            <li>@gap</li>
                        }
                    </ul>
                </div>
            </details>
        }

        @if (References.Count > 0)
        {
            <section aria-labelledby="portfolio-analysis-references">
                <h5 id="portfolio-analysis-references" class="mb-3">
                    <BIcon icon="bi-journal-text" extraClassName="me-1" />
                    References
                </h5>
                <ol class="list-group list-group-numbered">
                    @for (var index = 0; index < References.Count; index++)
                    {
                        var reference = References[index];
                        var safeUrl = SafeReferenceUrl(reference);
                        <li id="portfolio-analysis-reference-@(index + 1)"
                            class="analysis-reference list-group-item d-flex justify-content-between align-items-start gap-3">
                            <div class="ms-2 me-auto">
                                <div class="fw-semibold">
                                    @if (safeUrl is not null)
                                    {
                                        <a href="@safeUrl" target="_blank" rel="noopener noreferrer">@reference.Title</a>
                                    }
                                    else
                                    {
                                        <span>@reference.Title</span>
                                    }
                                </div>
                                <div class="small text-muted">
                                    @reference.Publisher - @SourceTypeLabel(reference.SourceType)
                                    @if (reference.PublishedAt is not null)
                                    {
                                        <span> - published @reference.PublishedAt.Value.ToUniversalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                    }
                                    <span> - accessed @reference.AccessedAt.ToUniversalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                </div>
                            </div>
                            <span class="badge @(reference.IsVerified ? "text-bg-success" : "text-bg-secondary")">
                                @(reference.IsVerified ? "Verified" : "Unverified")
                            </span>
                        </li>
                    }
                </ol>
            </section>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IPortfolioAnalysisResult Analysis { get; set; } = default!;

    private bool IsSupportedAnalysis => Analysis is PortfolioReview or PortfolioConstruction;

    private IReadOnlyList<string> ValidationWarnings => Analysis switch
    {
        PortfolioReview review => CleanStrings(review.ValidationWarnings),
        PortfolioConstruction construction => CleanStrings(construction.ValidationWarnings),
        _ => [],
    };

    private IReadOnlyList<string> CombinedDataGaps => Analysis switch
    {
        PortfolioReview review => CleanStrings(review.DataGaps.Concat(review.Snapshot.DataGaps)),
        PortfolioConstruction construction => CleanStrings(construction.DataGaps),
        _ => [],
    };

    private IReadOnlyList<ReferenceSource> References => Analysis switch
    {
        PortfolioReview review => review.References,
        PortfolioConstruction construction => construction.References,
        _ => [],
    };

    private string ReferenceHref(int referenceIndex)
    {
        var uri = new UriBuilder(NavigationManager.Uri)
        {
            Fragment = $"portfolio-analysis-reference-{referenceIndex + 1}",
        };

        return uri.Uri.AbsoluteUri;
    }

    private int FindReferenceIndex(string referenceId)
    {
        for (var index = 0; index < References.Count; index++)
        {
            if (string.Equals(References[index].Id, referenceId, StringComparison.OrdinalIgnoreCase))
            {
                return index;
            }
        }

        return -1;
    }

    private static string ReviewStatusLabel(PortfolioReviewStatus status)
    {
        return status switch
        {
            PortfolioReviewStatus.CompleteWithWarnings => "Complete with warnings",
            _ => "Complete",
        };
    }

    private static string ReviewStatusBadgeClass(PortfolioReviewStatus status)
    {
        return status switch
        {
            PortfolioReviewStatus.CompleteWithWarnings => "text-bg-warning",
            _ => "text-bg-success",
        };
    }

    private static string ReviewStatusBorderClass(PortfolioReviewStatus status)
    {
        return status switch
        {
            PortfolioReviewStatus.CompleteWithWarnings => "border-start border-start-4 border-start-warning",
            _ => "border-start border-start-4 border-start-success",
        };
    }

    private static string ConstructionStatusLabel(PortfolioConstructionStatus status)
    {
        return status switch
        {
            PortfolioConstructionStatus.CompleteWithWarnings => "Complete with warnings",
            _ => "Complete",
        };
    }

    private static string ConstructionStatusBadgeClass(PortfolioConstructionStatus status)
    {
        return status switch
        {
            PortfolioConstructionStatus.CompleteWithWarnings => "text-bg-warning",
            _ => "text-bg-success",
        };
    }

    private static string ConstructionStatusBorderClass(PortfolioConstructionStatus status)
    {
        return status switch
        {
            PortfolioConstructionStatus.CompleteWithWarnings => "border-start border-start-4 border-start-warning",
            _ => "border-start border-start-4 border-start-success",
        };
    }

    private static string StrategyLabel(PortfolioReviewStrategy strategy)
    {
        return strategy switch
        {
            PortfolioReviewStrategy.LongTerm => "Long term",
            _ => "Swing",
        };
    }

    private static string ConstructionModeLabel(PortfolioConstructionMode mode)
    {
        return mode switch
        {
            PortfolioConstructionMode.Seeded => "Seeded portfolio",
            _ => "Built from scratch",
        };
    }

    private static string DataQualityLabel(DataQuality quality)
    {
        return quality switch
        {
            DataQuality.Insufficient => "Insufficient",
            _ => quality.ToString(),
        };
    }

    private static string DataQualityBadgeClass(DataQuality quality)
    {
        return quality switch
        {
            DataQuality.High => "text-bg-success",
            DataQuality.Medium => "text-bg-warning",
            DataQuality.Low => "text-bg-danger",
            _ => "text-bg-dark",
        };
    }

    private static string RebalanceLabel(PortfolioReviewRebalanceFlag flag)
    {
        return flag switch
        {
            PortfolioReviewRebalanceFlag.YES => "Rebalance recommended",
            _ => "No rebalance recommended",
        };
    }

    private static string RebalanceBadgeClass(PortfolioReviewRebalanceFlag flag)
    {
        return flag switch
        {
            PortfolioReviewRebalanceFlag.YES => "text-bg-danger",
            _ => "text-bg-success",
        };
    }

    private static string RiskLevelLabel(PortfolioReviewRiskLevel level)
    {
        return level.ToString();
    }

    private static string RiskBorderClass(PortfolioReviewRiskLevel level)
    {
        return level switch
        {
            PortfolioReviewRiskLevel.Critical => "border-start-danger",
            PortfolioReviewRiskLevel.High => "border-start-warning",
            PortfolioReviewRiskLevel.Medium => "border-start-info",
            _ => "border-start-secondary",
        };
    }

    private static string RiskBadgeClass(PortfolioReviewRiskLevel level)
    {
        return level switch
        {
            PortfolioReviewRiskLevel.Critical => "text-bg-danger",
            PortfolioReviewRiskLevel.High => "text-bg-warning",
            PortfolioReviewRiskLevel.Medium => "text-bg-info",
            _ => "text-bg-secondary",
        };
    }

    private static string HoldingRecommendationLabel(PortfolioReviewHoldingRecommendation recommendation)
    {
        return recommendation switch
        {
            PortfolioReviewHoldingRecommendation.BUY_MORE => "Buy more",
            _ => recommendation.ToString(),
        };
    }

    private static string HoldingRecommendationBadgeClass(PortfolioReviewHoldingRecommendation recommendation)
    {
        return recommendation switch
        {
            PortfolioReviewHoldingRecommendation.EXIT => "text-bg-danger",
            PortfolioReviewHoldingRecommendation.TRIM => "text-bg-warning",
            PortfolioReviewHoldingRecommendation.BUY_MORE => "text-bg-success",
            _ => "text-bg-secondary",
        };
    }

    private static string ExitReasonLabel(PortfolioReviewExitReason reason)
    {
        return reason switch
        {
            PortfolioReviewExitReason.CriticalRisk => "Critical risk",
            PortfolioReviewExitReason.StructuralChange => "Structural change",
            PortfolioReviewExitReason.SwingRiskControl => "Swing risk control",
            PortfolioReviewExitReason.SwingThesisInvalidated => "Swing thesis invalidated",
            _ => reason.ToString(),
        };
    }

    private static string FormatBudget(PortfolioBudget budget)
    {
        if (budget.Amount is null)
        {
            return budget.BudgetType == PortfolioBudgetType.NotProvided
                ? "Not provided"
                : BudgetTypeLabel(budget.BudgetType);
        }

        var amount = FormatAmount(budget.Amount.Value, budget.Currency);
        return budget.Frequency is null
            ? amount
            : $"{amount} {BudgetFrequencyLabel(budget.Frequency.Value).ToLowerInvariant()}";
    }

    private static string BudgetTypeLabel(PortfolioBudgetType type)
    {
        return type switch
        {
            PortfolioBudgetType.NotProvided => "Not provided",
            PortfolioBudgetType.Total => "Total budget",
            _ => "Recurring budget",
        };
    }

    private static string BudgetFrequencyLabel(PortfolioBudgetFrequency frequency)
    {
        return frequency switch
        {
            PortfolioBudgetFrequency.Fortnightly => "Fortnightly",
            PortfolioBudgetFrequency.Annually => "Annually",
            _ => frequency.ToString(),
        };
    }

    private static string FormatAmount(double value, string? currency)
    {
        var amount = value.ToString("N2", CultureInfo.CurrentCulture);
        return IsPresent(currency)
            ? $"{currency!.Trim().ToUpperInvariant()} {amount}"
            : amount;
    }

    private static string FormatRatio(double value)
    {
        return value.ToString("P1", CultureInfo.CurrentCulture);
    }

    private static string FormatPercentagePointChange(double value)
    {
        return $"{(value * 100).ToString("+0.0;-0.0;0.0", CultureInfo.CurrentCulture)} pp";
    }

    private static string SignedValueClass(double value)
    {
        return value switch
        {
            > 0 => "text-success",
            < 0 => "text-danger",
            _ => "text-muted",
        };
    }

    private static string FormatTimestamp(DateTimeOffset timestamp)
    {
        return $"{timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)} UTC";
    }

    private static int ClampConfidence(int confidence)
    {
        return Math.Clamp(confidence, 0, 100);
    }

    private static Uri? SafeReferenceUrl(ReferenceSource reference)
    {
        return string.Equals(reference.Url.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
            || string.Equals(reference.Url.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
            ? reference.Url
            : null;
    }

    private static string SourceTypeLabel(ReferenceSourceType sourceType)
    {
        return sourceType switch
        {
            ReferenceSourceType.MarketData => "Market data",
            _ => sourceType.ToString(),
        };
    }

    private static IReadOnlyList<string> CleanStrings(IEnumerable<string> values)
    {
        return [.. values.Where(IsPresent).Distinct(StringComparer.OrdinalIgnoreCase)];
    }

    private static string ValueOrPlaceholder(string? value)
    {
        return IsPresent(value) ? value! : "--";
    }

    private static bool IsPresent(string? value)
    {
        return !string.IsNullOrWhiteSpace(value);
    }
}
