@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Pages
@using MyPo.Portfolio.Shared.Api
@using MyPo.Portfolio.Shared.Models
@using MyPo.Portfolio.Shared.Utils

@inherits CBasePlanView

<!-- Summary cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-start border-start-4 border-start-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 small">
                    <div class="text-uppercase">Market value</div>
                    <BIcon icon="bi-wallet2" extraClassName="text-info" />
                </div>
                <div class="h5 mb-0">@(Plan.TotalMarketValueStr()??"--")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-start border-start-4 border-start-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 small">
                    <div class="text-uppercase">Cost basic</div>
                    <BIcon icon="bi-cash-stack" extraClassName="text-secondary" />
                </div>
                <div class="h5 mb-0">@Plan.TotalCostBasicStr()</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-start border-start-4 @pnlBorderCssClass(Plan.TotalUnsettledPnL)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 small">
                    <div class="text-uppercase">Unsettled P&amp;L</div>
                    <BIcon icon="bi-graph-up-arrow" extraClassName="@pnlCssClass(Plan.TotalUnsettledPnL)" />
                </div>
                <div class="h5 mb-0 @(pnlCssClass(Plan.TotalUnsettledPnL))">@Plan.TotalUnsettledPnLStr()</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-start border-start-4 @pnlBorderCssClass(Plan.TotalUnsettledPnL)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 small">
                    <div class="text-uppercase">Overall return</div>
                    <BIcon icon="bi-percent" extraClassName="@pnlCssClass(Plan.TotalUnsettledPnL)" />
                </div>
                <div class="h5 mb-0 @(pnlCssClass(Plan.TotalUnsettledPnL))">@Plan.TotalUnsettledPnLYieldStr()</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-start border-start-4 border-start-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 small">
                    <div class="text-uppercase">Est. yearly dividend</div>
                    <BIcon icon="bi-cash-coin" extraClassName="text-success" />
                </div>
                <div class="h5 mb-0">@(Plan.EstTotalYearlyDividendStr()) (@Plan.EstTotalYearlyDividendYieldStr())</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-start border-start-4 @devBorderCssClass(Plan.MaxAllocationDiffPct)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 small">
                    <div class="text-uppercase">Max overweight</div>
                    <BIcon icon="bi-arrow-up-circle" extraClassName="@devCssClass(Plan.MaxAllocationDiffPct)" />
                </div>
                <div class="h5 mb-0 @(devCssClass(Plan.MaxAllocationDiffPct))">@(Plan.MaxAllocationDiffPctStr())</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-start border-start-4 @devBorderCssClass(Plan.MinAllocationDiffPct)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 small">
                    <div class="text-uppercase">Max underweight</div>
                    <BIcon icon="bi-arrow-down-circle" extraClassName="@devCssClass(Plan.MinAllocationDiffPct)" />
                </div>
                <div class="h5 mb-0 @(devCssClass(Plan.MinAllocationDiffPct))">@(Plan.MinAllocationDiffPctStr()??"--")</div>
            </div>
        </div>
    </div>
</div>

<!-- Holdings detail table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <h5 class="mb-0">Holdings Breakdown</h5>
            @if(string.IsNullOrEmpty(Plan.Metadata?.Description))
            {
                <div title="Add plan description to enable analysis">
                    <button class="btn btn-sm btn-outline-secondary ms-1" disabled><BIcon icon="bi-bar-chart-line" extraClassName="me-1"/>Analyze</button>
                </div>
            }
            else
            {
                <button class="btn btn-sm btn-outline-info ms-1" @onclick="Parent.BtnClickAnalyze" disabled="@Parent.analyzing"><BIcon icon="bi-bar-chart-line" extraClassName="me-1"/>Analyze</button>
            }
        </div>
        <span class="badge bg-secondary">@(Plan.Metadata?.HoldingTickers?.Count) symbols</span>
    </div>
    <div class="table-responsive">
        <style>
        .allocation-bar {
            position: relative;
            height: 16px;
            border-radius: 4px;
            overflow: hidden;
            background: var(--cui-secondary-bg);
        }

        .allocation-bar .bar-current {
            height: 100%;
            transition: width .4s ease;
        }

        .allocation-bar .bar-target {
            position: absolute;
            top: 0;
            height: 100%;
            width: 2px;
            background: var(--cui-dark);
        }
        </style>
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th aria-sort="@ariaSort(HoldingSortColumn.Ticker)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.Ticker)">
                            Ticker <BIcon icon="@sortIcon(HoldingSortColumn.Ticker)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.Shares)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.Shares)">
                            Shares <BIcon icon="@sortIcon(HoldingSortColumn.Shares)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.MarketPrice)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.MarketPrice)">
                            Mkt. Price <BIcon icon="@sortIcon(HoldingSortColumn.MarketPrice)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.MarketValue)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.MarketValue)">
                            Mkt. Value <BIcon icon="@sortIcon(HoldingSortColumn.MarketValue)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.DividendYield)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.DividendYield)">
                            Div Yield <BIcon icon="@sortIcon(HoldingSortColumn.DividendYield)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.EstimatedYearlyDividend)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.EstimatedYearlyDividend)">
                            Est. Yearly Div <BIcon icon="@sortIcon(HoldingSortColumn.EstimatedYearlyDividend)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.CurrentAllocation)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.CurrentAllocation)">
                            Current % <BIcon icon="@sortIcon(HoldingSortColumn.CurrentAllocation)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.TargetAllocation)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.TargetAllocation)">
                            Target % <BIcon icon="@sortIcon(HoldingSortColumn.TargetAllocation)" />
                        </button>
                    </th>
                    <th class="text-end" aria-sort="@ariaSort(HoldingSortColumn.Deviation)">
                        <button type="button" class="btn btn-link p-0 text-decoration-none text-body fw-semibold d-inline-flex align-items-center gap-1" @onclick="()=>sortBy(HoldingSortColumn.Deviation)">
                            Deviation <BIcon icon="@sortIcon(HoldingSortColumn.Deviation)" />
                        </button>
                    </th>
                    <th style="width:200px">Allocation</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                @foreach (var ht in sortedHoldings)
                {
                    <tr>
                        <td title="@ht.Tags">@FormatUtils.ExtractFirstCharIfEmoji(ht.Tags)@ht.Ticker</td>
                        <td class="text-end">@Plan.NumSharesStr(ht)</td>
                        <td class="text-end">@Plan.MarketPriceStr(ht)</td>
                        <td class="text-end">@Plan.MarketValueStr(ht)</td>
                        <td class="text-end">@($"{ht.DividendYield:N1}%")</td>
                        <td class="text-end">@Plan.EstYearlyDividendStr(ht)</td>
                        <td class="text-end">@Plan.CurrentAllocationPct(ht).ToString("N1")%</td>
                        <td class="text-end">@Plan.TargetAllocationPct(ht).ToString("N0")%</td>
                        <td class="text-end @(devCssClass(Plan.AllocationDiffPct(ht)))">@Plan.AllocationDiffPct(ht).ToString("N1")%</td>
                        <td>
                            <div class="allocation-bar" title="Current @(Plan.CurrentAllocationPct(ht).ToString("N1"))% / Target @(Plan.TargetAllocationPct(ht).ToString("N0"))% / Need @(Plan.AmoutNeededToFillDeviationStr(ht)) (@Plan.SharesNeededToFillDeviationStr(ht) shares)">
                                <div class="bar-current @(barCssClass(Plan.AllocationDiffPct(ht)))" style="width:@(Plan.CurrentAllocationPct(ht))%"></div>
                                <div class="bar-target" style="left:@(Plan.TargetAllocationPct(ht))%" title="Target @(Plan.TargetAllocationPct(ht).ToString("N0"))%"></div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public MyPortfolioPlansDetails Parent { get; set; } = default!;

    private enum HoldingSortColumn
    {
        Ticker,
        Shares,
        MarketPrice,
        MarketValue,
        DividendYield,
        EstimatedYearlyDividend,
        CurrentAllocation,
        TargetAllocation,
        Deviation,
    }

    private HoldingSortColumn sortColumn = HoldingSortColumn.Deviation;
    private bool sortDescending;

    private IEnumerable<HoldingTicker> sortedHoldings
    {
        get
        {
            var holdings = Plan.Metadata?.HoldingTickers ?? [];
            IOrderedEnumerable<HoldingTicker> sorted = (sortColumn, sortDescending) switch
            {
                (HoldingSortColumn.Ticker, false) => holdings.OrderBy(ht => ht.Ticker, StringComparer.OrdinalIgnoreCase),
                (HoldingSortColumn.Ticker, true) => holdings.OrderByDescending(ht => ht.Ticker, StringComparer.OrdinalIgnoreCase),
                (HoldingSortColumn.Shares, false) => holdings.OrderBy(ht => ht.Shares),
                (HoldingSortColumn.Shares, true) => holdings.OrderByDescending(ht => ht.Shares),
                (HoldingSortColumn.MarketPrice, false) => holdings.OrderBy(ht => ht.MarketPrice),
                (HoldingSortColumn.MarketPrice, true) => holdings.OrderByDescending(ht => ht.MarketPrice),
                (HoldingSortColumn.MarketValue, false) => holdings.OrderBy(ht => ht.Shares * ht.MarketPrice),
                (HoldingSortColumn.MarketValue, true) => holdings.OrderByDescending(ht => ht.Shares * ht.MarketPrice),
                (HoldingSortColumn.DividendYield, false) => holdings.OrderBy(ht => ht.DividendYield),
                (HoldingSortColumn.DividendYield, true) => holdings.OrderByDescending(ht => ht.DividendYield),
                (HoldingSortColumn.EstimatedYearlyDividend, false) => holdings.OrderBy(ht => ht.EstYearlyDividend),
                (HoldingSortColumn.EstimatedYearlyDividend, true) => holdings.OrderByDescending(ht => ht.EstYearlyDividend),
                (HoldingSortColumn.CurrentAllocation, false) => holdings.OrderBy(Plan.CurrentAllocationPct),
                (HoldingSortColumn.CurrentAllocation, true) => holdings.OrderByDescending(Plan.CurrentAllocationPct),
                (HoldingSortColumn.TargetAllocation, false) => holdings.OrderBy(Plan.TargetAllocationPct),
                (HoldingSortColumn.TargetAllocation, true) => holdings.OrderByDescending(Plan.TargetAllocationPct),
                (HoldingSortColumn.Deviation, false) => holdings.OrderBy(Plan.AllocationDiffPct),
                (HoldingSortColumn.Deviation, true) => holdings.OrderByDescending(Plan.AllocationDiffPct),
                _ => holdings.OrderBy(ht => ht.Ticker, StringComparer.OrdinalIgnoreCase),
            };
            return sorted.ThenBy(ht => ht.Ticker, StringComparer.OrdinalIgnoreCase);
        }
    }

    private void sortBy(HoldingSortColumn column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
    }

    private string sortIcon(HoldingSortColumn column)
    {
        return sortColumn != column
            ? "bi-arrow-down-up"
            : sortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill";
    }

    private string ariaSort(HoldingSortColumn column)
    {
        return sortColumn != column
            ? "none"
            : sortDescending ? "descending" : "ascending";
    }

    private string barCssClass(decimal dev)
    {
        var v = Math.Abs(dev);
        if (v <= 5)
        {
            return "bg-success bg-opacity-50";
        }
        if (v <= 11)
        {
            return "bg-info bg-opacity-75";
        }
        return "bg-danger bg-opacity-50";
    }

    private string devCssClass(decimal dev)
    {
        var v = Math.Abs(dev);
        if (v <= 1)
        {
            return "text-muted";
        }
        if (v <= 3)
        {
            return "text-success";
        }
        if (v <= 7)
        {
            return "text-info";
        }
        return "text-danger";
    }

    private string devBorderCssClass(decimal dev)
    {
        return devCssClass(dev) switch
        {
            "text-success" => "border-start-success",
            "text-info" => "border-start-info",
            "text-danger" => "border-start-danger",
            _ => "border-start-secondary",
        };
    }
}
