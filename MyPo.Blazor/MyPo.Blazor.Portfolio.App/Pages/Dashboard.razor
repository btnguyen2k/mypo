@using MyPo.Blazor.App.Layout
@using MyPo.Blazor.App.Shared
@using System.Reflection
@using MyPo.Portfolio.Shared.Api
@using MyPo.Portfolio.Shared.Models

@attribute [Route(UIGlobals.ROUTE_HOME)]
@inherits BasePage

<HeadContent>
    <!-- Plugins and styles required by this page-->
    <!--<link href="@UIGlobals.COREUI_BASE/vendors/@@coreui/chartjs/css/coreui-chartjs.css" rel="stylesheet">-->
	<link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" />
</HeadContent>

<PageTitle>Home | @AppInfo?.Name</PageTitle>

<SectionContent SectionId="MainLayout.Breadcrumb">
    <li class="breadcrumb-item">
        <a href="@UIGlobals.ROUTE_HOME">Home</a>
    </li>
    <li class="breadcrumb-item active">
        <span>Dashboard</span>
    </li>
</SectionContent>

<div class="container-lg px-4">
	<div class="card border-top-primary border-top-3 mb-4">
		<div class="card-body">
			<CAlert @ref="@Alert" />
			@if (!HideUI)
			{
				<nav>
					<div class="nav nav-tabs" id="nav-tab" role="tablist">
						<button class="nav-link @(ActiveTab==TabIdDividend?"active":"")"
							@onclick="(()=>SwitchTab(TabIdDividend))" id="@TabIdDividend"
							data-coreui-toggle="tab" data-coreui-target="#@(TabIdDividend)-content"
							type="button" role="tab" aria-controls="@(TabIdDividend)-content"
							aria-selected="@(ActiveTab==TabIdDividend?"true":"false")">Upcoming Dividends</button>
						<button class="nav-link @(ActiveTab==TabIdListing?"active":"")"
							@onclick="(()=>SwitchTab(TabIdListing))" id="@TabIdListing"
							data-coreui-toggle="tab" data-coreui-target="#@(TabIdListing)-content"
							type="button" role="tab" aria-controls="@(TabIdListing)-content"
							aria-selected="@(ActiveTab==TabIdListing?"true":"false")">New Listings</button>
						<button class="nav-link @(ActiveTab==TabIdEarnings?"active":"")"
							@onclick="(()=>SwitchTab(TabIdEarnings))" id="@TabIdEarnings"
							data-coreui-toggle="tab" data-coreui-target="#@(TabIdEarnings)-content"
							type="button" role="tab" aria-controls="@(TabIdEarnings)-content"
							aria-selected="@(ActiveTab==TabIdEarnings?"true":"false")">Upcoming Earnings</button>
					</div>
				</nav>
				<div class="tab-content" id="nav-tabContent">
					<div class="tab-pane fade @(ActiveTab==TabIdDividend?"show active":"")" id="@(TabIdDividend)-content" role="tabpanel" aria-labelledby="@TabIdDividend" tabindex="0">
						<div class="row mt-2">
							<div class="col-12">
								<div class="card">
									<div class="card-body">
										@if(EventsDistribution.Count <= 0)
										{
											<h5>No Data</h5>
										}
										else
										{
											<table class="table table-sm mb-0" id="tblDividendEvents">
												<thead>
													<tr>
														<th>Ex-Date</th>
														<th>Pay Date</th>
														<th class="text-center">Market</th>
														<th>Item</th>
														<th class="text-end">Amount</th>
														<th class="text-end">Cur.Price</th>
														<th class="text-end">This Yield</th>
														<th class="text-end">Pre.Price</th>
													</tr>
												</thead>
												<tbody>
													@foreach (var e in EventsDistribution)
													{
														<tr class="@(TextFormatDivident(e))">
															<td class="text-nowrap">@e.EventTimeLocalTz.ToString("yyyy-MM-dd")</td>
															<td class="text-nowrap">@(PaymentDateStr(e))</td>
															<td class="text-center">@e.MarketId</td>
															<td><a target="_blank" href="@(e.Metadata?.Link??"--")">@e.ItemCode</a> <small class="text-muted">@(e.Metadata?.CompanyName??"--")</small></td>
															<td class="text-end">@((e.Metadata?.Dividend?.Amount??0).ToString(DecimalFormatForMarket(e.MarketId))) @(e.Metadata?.CurrencySymbol??"--")</td>
															<td class="text-end">@(QuotesMap.TryGetValue(e.ItemCode, out var quote1082)?$"{quote1082.MarketPrice.ToString(DecimalFormatForMarket(e.MarketId))} {e.Metadata?.CurrencySymbol}":"--")</td>
															<td class="text-end">@(YieldsMap.TryGetValue(e.ItemCode, out var yield0142)&&yield0142>0?yield0142.ToString("P2"):"--")</td>
															<td class="text-end text-nowrap">
																@(PreExDivPrice.TryGetValue(e.ItemCode, out var quote9364)?$"{quote9364.ToString(DecimalFormatForMarket(e.MarketId))} {e.Metadata?.CurrencySymbol}":"--")
																@((MarkupString)(PreExDivPriceVsCurrentPrice(e) > 0
																	? $" <small class='text-success'>(+{PreExDivPriceVsCurrentPrice(e).ToString("P2")})</small>"
																	: PreExDivPriceVsCurrentPrice(e) < 0
																	  ? $" <small class='text-danger'>({PreExDivPriceVsCurrentPrice(e).ToString("P2")})</small>"
																	  : "")
																)
															</td>
														</tr>
													}
												</tbody>
											</table>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="tab-pane fade @(ActiveTab==TabIdListing?"show active":"")" id="@(TabIdListing)-content" role="tabpanel" aria-labelledby="@TabIdListing" tabindex="0">
						<div class="row mt-2">
							<div class="col-12">
								<div class="card">
									<div class="card-body">
										@if(EventsListing.Count <= 0)
										{
											<h5>No Data</h5>
										}
										else
										{
											<table class="table table-sm mb-0" id="tblListingEvents">
												<thead>
													<tr>
														<th>Date</th>
														<th class="text-center">Market</th>
														<th>Item</th>
														<th>Industry</th>
														<th class="text-end">Price</th>
														<th class="text-end">Cur.Price</th>
														<th class="text-end">Capital</th>
													</tr>
												</thead>
												<tbody>
													@foreach (var e in EventsListing)
													{
														<tr>
															<td>@e.EventTimeLocalTz.ToString("yyyy-MM-dd")</td>
															<td class="text-center">@e.MarketId</td>
															<td><a target="_blank" href="@(e.Metadata?.Link??"--")">@e.ItemCode</a> <small class="text-muted">@(e.Metadata?.CompanyName??"--")</small></td>
															<td>@(e.Metadata?.Industry??"--")</td>
															<td class="text-end">@((e.Metadata?.Listing?.Price??0).ToString(DecimalFormatForMarket(e.MarketId))) @(e.Metadata?.CurrencySymbol??"--")</td>
															<td class="text-end">@(QuotesMap.TryGetValue(e.ItemCode, out var quote0253)?$"{quote0253.MarketPrice.ToString(DecimalFormatForMarket(e.MarketId))} {e.Metadata?.CurrencySymbol}":"--")</td>
															<td class="text-end">@(e.Metadata?.Capital.ToString("N0")??"--")</td>
														</tr>
													}
												</tbody>
											</table>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="tab-pane fade @(ActiveTab==TabIdEarnings?"show active":"")" id="@(TabIdEarnings)-content" role="tabpanel" aria-labelledby="@TabIdEarnings" tabindex="0">
						<div class="row mt-2">
							<div class="col-12">
								<div class="card">
									<div class="card-body">
										@if(EventsEarnings.Count <= 0)
										{
											<h5>No Data</h5>
										}
										else
										{
											<table class="table table-sm mb-0" id="tblEarningsEvents">
												<thead>
													<tr>
														<th>Date</th>
														<th class="text-center">Market</th>
														<th>Item</th>
														<th>Status</th>
														<th class="text-end">Period</th>
													</tr>
												</thead>
												<tbody>
													@foreach (var e in EventsEarnings)
													{
														<tr>
															<td>@e.EventTimeLocalTz.ToString("yyyy-MM-dd")</td>
															<td class="text-center">@e.MarketId</td>
															<td><a target="_blank" href="@(e.Metadata?.Link??"--")">@e.ItemCode</a> <small class="text-muted">@(e.Metadata?.CompanyName??"--")</small></td>
															<td>@(e.Metadata?.Status??"--")</td>
															<td class="text-end">@(e.Metadata?.Earnings?.ReportPeriod??"--")</td>
														</tr>
													}
												</tbody>
											</table>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			}
			@if (!string.IsNullOrEmpty(BackgroundMsg))
			{
				<div class="alert alert-light mt-2" role="alert">
					<span style="font-size: small !important;">@BackgroundMsg</span>
				</div>
			}
		</div>
	</div>
</div>

<!-- Plugins and scripts required by this page-->
<!--
<script src="@UIGlobals.COREUI_BASE/vendors/chart.js/js/chart.umd.js"></script>
<script src="@UIGlobals.COREUI_BASE/vendors/@@coreui/chartjs/js/coreui-chartjs.js"></script>
-->
