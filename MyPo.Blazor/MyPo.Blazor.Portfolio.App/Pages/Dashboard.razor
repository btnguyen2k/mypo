<script src="https://code.jquery.com/jquery-4.0.0.min.js" integrity="sha256-OaVG6prZf4v69dPg6PhVattBXkcOWQB62pdZ3ORyrao=" crossorigin="anonymous"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
@code {
	private static string PaymentDateStr(MarketEventResp e)
	{
		if (!string.IsNullOrEmpty(e.Metadata?.Dividend?.PaymentDate??null) && e.Metadata!.Dividend!.PaymentDate!.Length >= 10)
		{
			return DateTime.Parse(e.Metadata.Dividend.PaymentDate.Substring(0, 10)).ToString("MMM dd");
		}
		return "--";
	}
	private decimal PreExDivPriceVsCurrentPrice(MarketEventResp e)
	{
		if (QuotesMap.TryGetValue(e.ItemCode, out var quote) && PreExDivPrice.TryGetValue(e.ItemCode, out var preExDivPrice))
		{
			if (quote.MarketPrice > 0)
			{
				return (quote.MarketPrice+e.Metadata?.Dividend?.Amount??0 - preExDivPrice) / preExDivPrice - 1;
			}
		}
		return 0;
	}

	private static string DecimalFormatForMarket(string countryCode)
	{
		return countryCode.ToUpper() switch
		{
			"VN" => "F0",
			_ => "F2"
		};
	}

	private string TextFormatDivident(MarketEventResp e)
	{
		if (e.MarketId=="VN")
		{
			if (e.Metadata?.Dividend?.Amount >= 3000)
			{
				return "table-danger";
			}
			else if (YieldsMap.TryGetValue(e.ItemCode, out var yield) && yield >= 0.04m)
			{
				return "table-success";
			}
		}
		else if (YieldsMap.TryGetValue(e.ItemCode, out var yield))
		{
			if (e.Metadata?.Dividend?.Amount >= 1.00m && yield >= 0.04m)
			{
				return "table-danger";
			}
			if (e.Metadata?.Dividend?.Amount >= 5.00m && yield >= 0.02m)
			{
				return "table-danger";
			}
			if (e.Metadata?.Dividend?.Amount >= 0.03m && yield >= 0.07m)
			{
				return "table-success";
			}
			if (e.Metadata?.Dividend?.Amount >= 0.03m && yield >= 0.03m)
			{
				return "table-info";
			}
		}
		return "";
	}
}
