@using MyPo.Blazor.App.Layout
@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Portfolio.Shared.Identity

@attribute [Route(UIGlobals.ROUTE_HOME)]
@inherits BasePage

<SectionContent SectionId="MainLayout.Breadcrumb">
    <li class="breadcrumb-item">
        <a href="@UIGlobals.ROUTE_HOME">Home</a>
    </li>
    <li class="breadcrumb-item active">
        <span>@PAGE_TITLE</span>
    </li>
</SectionContent>

<AuthorizeView>
    <Authorizing>
        <AuthorizingView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Authorizing...")" />
    </Authorizing>
    <NotAuthorized>
        <NotAuthorizedView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Not Authorized")" LoginUrl="@LoginUrl" />
    </NotAuthorized>
    <Authorized>
        <PageTitle>@PAGE_TITLE | @AppInfo?.Name v@(AppInfo?.Version)</PageTitle>
        <div class="container-lg px-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <div>
                    <h2 class="mb-1">Portfolio dashboard</h2>
                    <p class="text-muted mb-0">Current value, performance, and portfolio health at a glance.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadPortfoliosAsync" disabled="@HideUI">
                        <BIcon icon="bi-arrow-clockwise" extraClassName="me-1" />Refresh
                    </button>
                    <AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
                        <ChildContent Context="ctx_add_portfolio_dashboard">
                            <a class="btn btn-primary btn-sm" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_ADD">
                                <BIcon icon="bi-plus-lg" extraClassName="me-1" />New portfolio
                            </a>
                        </ChildContent>
                    </AuthorizeView>
                </div>
            </div>

            <CAlert @ref="@Alert" />

            @if (!HideUI && Portfolios.Count == 0)
            {
                <div class="card border-top-primary border-top-3">
                    <div class="card-body text-center py-5">
                        <BIcon icon="bi-briefcase" extraClassName="display-5 text-muted" />
                        <h3 class="mt-3">Create your first portfolio</h3>
                        <p class="text-muted">Your portfolio values and health indicators will appear here.</p>
                        <AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
                            <ChildContent Context="ctx_empty_add_portfolio">
                                <a class="btn btn-primary" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_ADD">
                                    <BIcon icon="bi-plus-lg" extraClassName="me-1" />New portfolio
                                </a>
                            </ChildContent>
                        </AuthorizeView>
                    </div>
                </div>
            }
            else if (!HideUI)
            {
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-xl-3">
                        <div class="card h-100 border-start border-start-4 border-start-primary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small text-uppercase">Active portfolios</div>
                                        <div class="display-6 fw-semibold">@ActivePortfolios.Count</div>
                                    </div>
                                    <BIcon icon="bi-briefcase" extraClassName="fs-2 text-primary" />
                                </div>
                                <div class="small text-muted mt-2">
                                    @InvestmentPortfolios.Count investments
                                    @if (ActiveContainerCount > 0)
                                    {
                                        <span> | @ActiveContainerCount containers</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card h-100 border-start border-start-4 border-start-info">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="text-muted small text-uppercase">Market value</div>
                                    <BIcon icon="bi-wallet2" extraClassName="fs-3 text-info" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="text-muted">@summary.Currency</span>
                                        <span class="fw-semibold">@FormatAmount(summary.MarketValue)</span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card h-100 border-start border-start-4 border-start-secondary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="text-muted small text-uppercase">Invested cost</div>
                                    <BIcon icon="bi-cash-stack" extraClassName="fs-3 text-secondary" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="text-muted">@summary.Currency</span>
                                        <span class="fw-semibold">@FormatAmount(summary.TotalCosts)</span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card h-100 border-start border-start-4 @AggregatePnlBorderClass">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="text-muted small text-uppercase">Unrealized P/L</div>
                                    <BIcon icon="bi-graph-up-arrow" extraClassName="@($"fs-3 {AggregatePnlTextClass}")" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2 @PnlTextClass(summary.TotalPnl)">
                                        <span>@summary.Currency</span>
                                        <span class="fw-semibold">
                                            @FormatSignedAmount(summary.TotalPnl)
                                            <small>(@FormatPercentage(summary.TotalPnlPct))</small>
                                        </span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-xl-8">
                        <div class="card h-100 border-top-primary border-top-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="card-title mb-0">Portfolio overview</h4>
                                    <small class="text-muted">Current valuation for active investment portfolios</small>
                                </div>
                                <a class="btn btn-outline-primary btn-sm" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO">
                                    View all <BIcon icon="bi-arrow-right" extraClassName="ms-1" />
                                </a>
                            </div>
                            <div class="card-body p-0">
                                @if (InvestmentPortfolios.Count == 0)
                                {
                                    <div class="text-center text-muted py-5">
                                        <BIcon icon="bi-pie-chart" extraClassName="fs-1" />
                                        <p class="mb-0 mt-2">No active investment portfolios.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="ps-3">Portfolio</th>
                                                    <th class="text-end">Market value</th>
                                                    <th class="text-end">Invested cost</th>
                                                    <th class="text-end">P/L</th>
                                                    <th>Valuation</th>
                                                    <th class="text-end pe-3"></th>
                                                </tr>
                                            </thead>
                                            <tbody class="table-group-divider">
                                                @foreach (var portfolio in InvestmentPortfolios)
                                                {
                                                    <tr>
                                                        <td class="ps-3">
                                                            <div class="fw-semibold">@portfolio.Name</div>
                                                            <div class="small text-muted">
                                                                @portfolio.Currency
                                                                @if (!string.IsNullOrEmpty(ParentName(portfolio)))
                                                                {
                                                                    <span> | @ParentName(portfolio)</span>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td class="text-end text-nowrap">@FormatAmount(portfolio.TotalMarketValue)</td>
                                                        <td class="text-end text-nowrap">@FormatAmount(portfolio.TotalCosts)</td>
                                                        <td class="text-end text-nowrap @PnlTextClass(portfolio.TotalPnl)">
                                                            <div class="fw-semibold">@FormatSignedAmount(portfolio.TotalPnl)</div>
                                                            <small>@FormatPercentage(portfolio.TotalPnlPct)</small>
                                                        </td>
                                                        <td>
                                                            <span class="badge @FreshnessBadgeClass(portfolio)">@FreshnessText(portfolio)</span>
                                                        </td>
                                                        <td class="text-end pe-3">
                                                            <a class="btn btn-outline-primary btn-sm" href="@PortfolioDetailsUrl(portfolio.Id)" title="Open portfolio">
                                                                <BIcon icon="bi-arrow-right" />
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4">
                        <div class="card h-100 border-top-warning border-top-3">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Attention center</h4>
                                <small class="text-muted">Items that may need review</small>
                            </div>
                            <div class="card-body">
                                @if (AttentionItems.Count == 0)
                                {
                                    <div class="text-center py-4">
                                        <BIcon icon="bi-check-circle" extraClassName="display-6 text-success" />
                                        <h5 class="mt-3 mb-1">Everything looks current</h5>
                                        <p class="small text-muted mb-0">No valuation issues were found.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var item in AttentionItems)
                                        {
                                            <a class="list-group-item list-group-item-action px-0" href="@PortfolioDetailsUrl(item.PortfolioId)">
                                                <div class="d-flex gap-3">
                                                    <BIcon icon="@item.Icon" extraClassName="@($"fs-5 {item.TextClass}")" />
                                                    <div>
                                                        <div class="fw-semibold">@item.PortfolioName</div>
                                                        <div class="small text-muted">@item.Message</div>
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (BestPerformer is not null || WeakestPerformer is not null)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h4 class="card-title mb-0">Performance highlights</h4>
                            <small class="text-muted">Unrealized return based on current market value and invested cost</small>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @if (BestPerformer is not null)
                                {
                                    <div class="col-md-6">
                                        <a class="card h-100 text-decoration-none @BestPerformerBorderClass" href="@PortfolioDetailsUrl(BestPerformer.Id)">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <div>
                                                        <div class="small text-muted text-uppercase">Best performer</div>
                                                        <h5 class="text-body mb-1">@BestPerformer.Name</h5>
                                                        <span class="text-muted">@BestPerformer.Currency</span>
                                                    </div>
                                                    <div class="text-end @PnlTextClass(BestPerformer.TotalPnl)">
                                                        <BIcon icon="bi-arrow-up-right-circle" extraClassName="fs-3" />
                                                        <div class="h5 mb-0 mt-1">@FormatPercentage(BestPerformer.TotalPnlPct)</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                                @if (WeakestPerformer is not null)
                                {
                                    <div class="col-md-6">
                                        <a class="card h-100 text-decoration-none @WeakestPerformerBorderClass" href="@PortfolioDetailsUrl(WeakestPerformer.Id)">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <div>
                                                        <div class="small text-muted text-uppercase">Lowest return</div>
                                                        <h5 class="text-body mb-1">@WeakestPerformer.Name</h5>
                                                        <span class="text-muted">@WeakestPerformer.Currency</span>
                                                    </div>
                                                    <div class="text-end @PnlTextClass(WeakestPerformer.TotalPnl)">
                                                        <BIcon icon="bi-arrow-down-right-circle" extraClassName="fs-3" />
                                                        <div class="h5 mb-0 mt-1">@FormatPercentage(WeakestPerformer.TotalPnlPct)</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="card-title mb-0">Quick actions</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-6 col-lg-3">
                                <a class="btn btn-outline-primary w-100 text-start py-3" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO">
                                    <BIcon icon="bi-briefcase" extraClassName="me-2" />Manage portfolios
                                </a>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <a class="btn btn-outline-primary w-100 text-start py-3" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_PLANS">
                                    <BIcon icon="bi-distribute-vertical" extraClassName="me-2" />Portfolio plans
                                </a>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <a class="btn btn-outline-primary w-100 text-start py-3" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_EVENTS">
                                    <BIcon icon="bi-calendar-event" extraClassName="me-2" />Market events
                                </a>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <a class="btn btn-outline-primary w-100 text-start py-3" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_TOOL_BUY_SELL_WITH_FEE">
                                    <BIcon icon="bi-calculator" extraClassName="me-2" />Buy/sell calculator
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private const string PAGE_TITLE = "Dashboard";
}
