@using MyPo.Blazor.App.Layout
@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Portfolio.Shared.Identity

@attribute [Route(UIGlobals.ROUTE_HOME)]
@inherits BasePage

<SectionContent SectionId="MainLayout.Breadcrumb">
    <li class="breadcrumb-item">
        <a href="@UIGlobals.ROUTE_HOME">Home</a>
    </li>
    <li class="breadcrumb-item active">
        <span>@PAGE_TITLE</span>
    </li>
</SectionContent>

<AuthorizeView>
    <Authorizing>
        <AuthorizingView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Authorizing...")" />
    </Authorizing>
    <NotAuthorized>
        <NotAuthorizedView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Not Authorized")" LoginUrl="@LoginUrl" />
    </NotAuthorized>
    <Authorized>
        <PageTitle>@PAGE_TITLE | @AppInfo?.Name v@(AppInfo?.Version)</PageTitle>
        <div class="container-lg px-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <div>
                    <h2 class="mb-1">Portfolio dashboard</h2>
                    <p class="text-muted mb-0">Current value, performance, and portfolio health at a glance.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadPortfoliosAsync" disabled="@HideUI">
                        <BIcon icon="bi-arrow-clockwise" extraClassName="me-1" />Refresh
                    </button>
                    <AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
                        <ChildContent Context="ctx_add_portfolio_dashboard">
                            <a class="btn btn-primary btn-sm" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_ADD">
                                <BIcon icon="bi-plus-lg" extraClassName="me-1" />New portfolio
                            </a>
                        </ChildContent>
                    </AuthorizeView>
                </div>
            </div>

            <CAlert @ref="@Alert" />

            @if (!HideUI && Portfolios.Count == 0)
            {
                <div class="card border-top-primary border-top-3">
                    <div class="card-body text-center py-5">
                        <BIcon icon="bi-briefcase" extraClassName="display-5 text-muted" />
                        <h3 class="mt-3">Create your first portfolio</h3>
                        <p class="text-muted">Your portfolio values and health indicators will appear here.</p>
                        <AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
                            <ChildContent Context="ctx_empty_add_portfolio">
                                <a class="btn btn-primary" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_ADD">
                                    <BIcon icon="bi-plus-lg" extraClassName="me-1" />New portfolio
                                </a>
                            </ChildContent>
                        </AuthorizeView>
                    </div>
                </div>
            }
            else if (!HideUI)
            {
                <!-- SECTION: Currency Summary -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-md-4 col-xl-2">
                        <div class="card h-100 border-start border-start-4 border-start-danger">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2 small">
                                    <div class="text-uppercase">Cost basic</div>
                                    <BIcon icon="bi-cash-stack" extraClassName="text-secondary" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2 small">
                                        <span class="text-muted">@summary.Currency</span>
                                        <span class="fw-semibold">@FormatAmount(summary.CostBasic)</span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-xl-2">
                        <div class="card h-100 border-start border-start-4 border-start-info">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2 small">
                                    <div class="text-uppercase">Market value</div>
                                    <BIcon icon="bi-wallet2" extraClassName="text-info" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2 small">
                                        <span class="text-muted">@summary.Currency</span>
                                        <span class="fw-semibold">@FormatAmount(summary.MarketValue)</span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-xl-2">
                        <div class="card h-100 border-start border-start-4 @AggregatePnlBorderClass">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2 small">
                                    <div class="text-uppercase">Unrealized P/L</div>
                                    <BIcon icon="bi-graph-up-arrow" extraClassName="@($"{AggregatePnlTextClass}")" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2 @PnlTextClass(summary.UnrealizedPnl) small">
                                        <span>@summary.Currency</span>
                                        <span class="fw-semibold">
                                            @FormatSignedAmount(summary.UnrealizedPnl)
                                            <small>(@FormatPercentage(summary.UnrealizedPnlPct))</small>
                                        </span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-xl-2">
                        <div class="card h-100 border-start border-start-4 border-start-primary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2 small">
                                    <div class="text-uppercase">Σ investment</div>
                                    <BIcon icon="bi-bank" extraClassName="text-primary" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2 small">
                                        <span class="text-muted">@summary.Currency</span>
                                        <span class="fw-semibold">@FormatAmount(summary.TotalInvestment)</span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-xl-2">
                        <div class="card h-100 border-start border-start-4 border-start-success">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2 small">
                                    <div class="text-uppercase">Σ return</div>
                                    <BIcon icon="bi-cash-coin" extraClassName="text-success" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2 small">
                                        <span class="text-muted">@summary.Currency</span>
                                        <span class="fw-semibold">@FormatAmount(summary.TotalReturn)</span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-xl-2">
                        <div class="card h-100 border-start border-start-4 @AggregateTotalUnrealizedPnlBorderClass">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2 small">
                                    <div class="text-uppercase">Σ unrealized P/L</div>
                                    <BIcon icon="bi-graph-up" extraClassName="@($"{AggregateTotalUnrealizedPnlTextClass}")" />
                                </div>
                                @foreach (var summary in CurrencySummaries)
                                {
                                    <div class="d-flex justify-content-between gap-2 @PnlTextClass(summary.TotalUnrealizedPnl) small">
                                        <span>@summary.Currency</span>
                                        <span class="fw-semibold">
                                            @FormatSignedAmount(summary.TotalUnrealizedPnl)
                                            <small>(@FormatPercentage(summary.TotalUnrealizedPnlPct))</small>
                                        </span>
                                    </div>
                                }
                                @if (CurrencySummaries.Count == 0)
                                {
                                    <div class="h4 mb-0">--</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <!-- SECTION: Portfolio Overview -->
                    <div class="col-xl-8">
                        <div class="card h-100 border-top-primary border-top-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="card-title mb-0">Portfolio overview</h4>
                                    <small class="text-muted">Key valuation and return metrics for active investment portfolios</small>
                                </div>
                                <a class="btn btn-outline-primary btn-sm" href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO">
                                    View all <BIcon icon="bi-arrow-right" extraClassName="ms-1" />
                                </a>
                            </div>
                            <div class="card-body p-0">
                                @if (InvestmentPortfolios.Count == 0)
                                {
                                    <div class="text-center text-muted py-5">
                                        <BIcon icon="bi-pie-chart" extraClassName="fs-1" />
                                        <p class="mb-0 mt-2">No active investment portfolios.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var portfolio in InvestmentPortfolios)
                                        {
                                            var unrealizedPnl = portfolio.Metadata?.UnrealizedPnl ?? 0m;
                                            var unrealizedPnlPct = portfolio.Metadata?.UnrealizedPnlPct ?? 0m;
                                            var totalUnrealizedPnl = portfolio.Metadata?.TotalUnrealizedPnl ?? 0m;
                                            var totalUnrealizedPnlPct = portfolio.Metadata?.TotalUnrealizedPnlPct ?? 0m;

                                            <div class="list-group-item p-3">
                                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                                    <div>
                                                        <div class="fw-semibold">@portfolio.Name</div>
                                                        <div class="small text-muted">
                                                            @portfolio.Currency
                                                            @if (!string.IsNullOrEmpty(ParentName(portfolio)))
                                                            {
                                                                <span> | @ParentName(portfolio)</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge @FreshnessBadgeClass(portfolio)">@FreshnessText(portfolio)</span>
                                                        <a class="btn btn-outline-primary btn-sm" href="@PortfolioDetailsUrl(portfolio.Id)" title="Open portfolio">
                                                            <BIcon icon="bi-arrow-right" />
                                                        </a>
                                                    </div>
                                                </div>

                                                <div class="row g-3 mt-0">
                                                    <div class="col-6 col-md-4">
                                                        <div class="small text-muted">Cost basic</div>
                                                        <div class="fw-semibold text-nowrap">@FormatAmount(GetCostBasic(portfolio))</div>
                                                    </div>
                                                    <div class="col-6 col-md-4">
                                                        <div class="small text-muted">Market value</div>
                                                        <div class="fw-semibold text-nowrap">@FormatAmount(GetMarketValue(portfolio))</div>
                                                    </div>
                                                    <div class="col-6 col-md-4">
                                                        <div class="small text-muted">Unrealized P/L</div>
                                                        <div class="text-nowrap @PnlTextClass(unrealizedPnl)">
                                                            <span class="fw-semibold">@FormatSignedAmount(unrealizedPnl)</span>
                                                            <small>(@FormatPercentage(unrealizedPnlPct))</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-6 col-md-4">
                                                        <div class="small text-muted">Total investment</div>
                                                        <div class="fw-semibold text-nowrap">@FormatAmount(portfolio.Metadata?.TotalInvestment ?? 0m)</div>
                                                    </div>
                                                    <div class="col-6 col-md-4">
                                                        <div class="small text-muted">Total return</div>
                                                        <div class="fw-semibold text-nowrap">@FormatAmount(portfolio.Metadata?.TotalReturn ?? 0m)</div>
                                                    </div>
                                                    <div class="col-6 col-md-4">
                                                        <div class="small text-muted">Total unrealized P/L</div>
                                                        <div class="text-nowrap @PnlTextClass(totalUnrealizedPnl)">
                                                            <span class="fw-semibold">@FormatSignedAmount(totalUnrealizedPnl)</span>
                                                            <small>(@FormatPercentage(totalUnrealizedPnlPct))</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- SECTION: Attention Center -->
                    <div class="col-xl-4">
                        <div class="card h-100 border-top-warning border-top-3">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Attention center</h4>
                                <small class="text-muted">Portfolio plans that may need review</small>
                            </div>
                            <div class="card-body">
                                @if (AttentionItems.Count == 0)
                                {
                                    <div class="text-center py-4">
                                        <BIcon icon="bi-check-circle" extraClassName="display-6 text-success" />
                                        <h5 class="mt-3 mb-1">Everything looks current</h5>
                                        <p class="small text-muted mb-0">No portfolio plan actions were found.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var item in AttentionItems)
                                        {
                                            <a class="list-group-item list-group-item-action px-0" href="@item.TargetUrl">
                                                <div class="d-flex gap-3">
                                                    <BIcon icon="@item.Icon" extraClassName="@($"fs-5 {item.TextClass}")" />
                                                    <div>
                                                        <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                                            <span class="fw-semibold">@item.Title</span>
                                                            <span class="badge @item.BadgeClass">@item.BadgeText</span>
                                                        </div>
                                                        <div class="small text-muted">@item.Message</div>
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION: Performance highlights -->
                @if (BestPerformer is not null || WeakestPerformer is not null)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h4 class="card-title mb-0">Performance highlights</h4>
                            <small class="text-muted">Unrealized return based on current market value and cost basic</small>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @if (BestPerformer is not null)
                                {
                                    <div class="col-md-6">
                                        <a class="card h-100 text-decoration-none @BestPerformerBorderClass" href="@PortfolioDetailsUrl(BestPerformer.Id)">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <div>
                                                        <div class="small text-muted text-uppercase">Best performer</div>
                                                        <h5 class="text-body mb-1">@BestPerformer.Name</h5>
                                                        <span class="text-muted">@BestPerformer.Currency</span>
                                                    </div>
                                                    <div class="text-end @PnlTextClass(BestPerformer.Metadata?.TotalUnrealizedPnl??0m)">
                                                        <BIcon icon="bi-arrow-up-right-circle" extraClassName="fs-3" />
                                                        <div class="h5 mb-0 mt-1">@FormatPercentage(BestPerformer.Metadata?.TotalUnrealizedPnlPct??0m)</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                                @if (WeakestPerformer is not null)
                                {
                                    <div class="col-md-6">
                                        <a class="card h-100 text-decoration-none @WeakestPerformerBorderClass" href="@PortfolioDetailsUrl(WeakestPerformer.Id)">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <div>
                                                        <div class="small text-muted text-uppercase">Lowest return</div>
                                                        <h5 class="text-body mb-1">@WeakestPerformer.Name</h5>
                                                        <span class="text-muted">@WeakestPerformer.Currency</span>
                                                    </div>
                                                    <div class="text-end @PnlTextClass(WeakestPerformer.Metadata?.TotalUnrealizedPnl??0m)">
                                                        <BIcon icon="bi-arrow-down-right-circle" extraClassName="fs-3" />
                                                        <div class="h5 mb-0 mt-1">@FormatPercentage(WeakestPerformer.Metadata?.TotalUnrealizedPnlPct??0m)</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private const string PAGE_TITLE = "Dashboard";
}
