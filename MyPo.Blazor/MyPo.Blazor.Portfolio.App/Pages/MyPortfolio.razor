@using MyPo.Blazor.App.Shared;
@using MyPo.Blazor.Portfolio.App.Shared;
@using MyPo.Blazor.App.Layout;
@using MyPo.Portfolio.Shared.Identity;

@attribute [Route(PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO)]
@inherits BasePage

<SectionContent SectionId="MainLayout.Breadcrumb">
    <li class="breadcrumb-item">
        <a href="@UIGlobals.ROUTE_HOME">Home</a>
    </li>
    <li class="breadcrumb-item active">
        <span>@PAGE_TITLE</span>
    </li>
</SectionContent>

<AuthorizeView>
    <Authorizing>
        <AuthorizingView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Authorizing...")" />
    </Authorizing>
    <NotAuthorized>
        <NotAuthorizedView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Not Authorized")" LoginUrl="@LoginUrl" />
    </NotAuthorized>
    <Authorized>
		<PageTitle>@PAGE_TITLE | @AppInfo?.Name v@(AppInfo?.Version)</PageTitle>
        <div class="container-lg px-4">
            <div class="card border-top-primary border-top-3 mb-4">
                <div class="card-header">
                    <h4 class="card-title">My Portfolios</h4>
                </div>
                <div class="card-body">
					@if (!string.IsNullOrEmpty(AlertMessage))
					{
						<CAlert type="@AlertType">
							@AlertMessage
						</CAlert>
					}
					@if (!HideUI)
					{
						<AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
							<ChildContent Context="context1">
								<button class="btn btn-primary btn-sm mb-3" @onclick="BtnClickAdd"><CIcon icon="cil-plus" /> New Portfolio</button>
							</ChildContent>
						</AuthorizeView>
					}
                    @if (MyActivePortfolioList != null && !HideUI)
                    {
                        <table class="table table-sm table-bordered border-primary table-striped table-hover align-middle">
                            <thead>
                                <tr>
									<th scope="col" class="text-center">&nbsp;</th>
                                    <th scope="col" class="text-center">Currency</th>
                                    <th scope="col" class="text-center">Name</th>
									<th scope="col" class="text-center">Investment</th>
									<th scope="col" class="text-center">Return</th>
									<th scope="col" class="text-center">Actions</th>
                                </tr>
                            </thead>
							@if (MyActivePortfolioList.Count() == 0)
							{
								<tbody>
									<tr>
										<td colspan="6" class="text-center">No data found.</td>
									</tr>
								</tbody>
							}
							else
							{
								<tbody>
									@foreach (var item in MyActivePortfolioList)
									{
										<tr>
											<td class="text-center"><BIcon icon="diagram-2" /></td>
											<td class="text-center">@item.Currency</td>
											<td>
												@item.Name
												<br/>
												<span class="small">@item.Description</span>
											</td>
											<td>-</td>
											<td>-</td>
											<td class="text-center">
												<button class="btn btn-sm btn-outline-primary" @onclick="(()=>BtnClickInfo(item.Id))">
													<CIcon icon="cil-info" />
												</button>
												<button class="btn btn-sm btn-outline-info" @onclick="(()=>BtnClickModify(item.Id))">
													<CIcon icon="cil-pencil" />
												</button>
												<button class="btn btn-sm btn-outline-danger" @onclick="(()=>BtnClickDelete(item.Id))">
													<CIcon icon="cil-x" />
												</button>
											</td>
										</tr>
									}
								</tbody>
							}
                        </table>
                    }
					@if (!HideUI)
					{
						<AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
							<ChildContent Context="context2">
								<button class="btn btn-primary btn-sm float-end" @onclick="BtnClickAdd"><CIcon icon="cil-plus" /> New Portfolio</button>
							</ChildContent>
						</AuthorizeView>
					}
                </div>
            </div>

			@if (!HideUI && MyInactivePortfolioList != null && MyInactivePortfolioList.Count() > 0)
			{
				<div class="card border-top-secondary border-top-3 mb-4">
					<div class="card-header">
						<h4 class="card-title">My Inactive Portfolios</h4>
					</div>
					<div class="card-body">
						<table class="table table-sm table-bordered border-primary table-striped table-hover align-middle">
							<thead>
								<tr>
									<th scope="col" class="text-center">&nbsp;</th>
									<th scope="col" class="text-center">Currency</th>
									<th scope="col" class="text-center">Name</th>
									<th scope="col" class="text-center">Investment</th>
									<th scope="col" class="text-center">Return</th>
									<th scope="col" class="text-center">Actions</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in MyInactivePortfolioList)
								{
									<tr>
										<td class="text-center"><BIcon icon="diagram-2" /></td>
										<td class="text-center">@item.Currency</td>
										<td>
											@item.Name
											<br/>
											<span class="small">@item.Description</span>
										</td>
										<td>-</td>
										<td>-</td>
										<td>-</td>
										@*
										<td>
											<button class="btn btn-sm btn-primary me-1" title="View Details" @onclick="(()=>BtnClickViewDetails(item.Id))"><CIcon icon="cil-magnifying-glass" /></button>
											<AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
												<ChildContent Context="context3">
													<button class="btn btn-sm btn-secondary me-1" title="Edit Portfolio" @onclick="(()=>BtnClickEdit(item.Id))"><CIcon icon="cil-pencil" /></button>
													<button class="btn btn-sm btn-danger" title="Delete Portfolio" @onclick="(()=>BtnClickDelete(item.Id))"><CIcon icon="cil-trash" /></button>
												</ChildContent>
											</AuthorizeView>
										</td>
										*@
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
        </div>
	</Authorized>
</AuthorizeView>

@code {
    private const string PAGE_TITLE = "My Portfolio";
}
