@using MyPo.Blazor.App.Shared;
@using MyPo.Blazor.Portfolio.App.Shared;
@using MyPo.Blazor.App.Layout;
@using MyPo.Portfolio.Shared.Identity;

@attribute [Route(PortfolioUIGlobals.ROUTE_PORTFOLIO_STOCK_SYMBOL_INFO_EMPTY)]
@attribute [Route(PortfolioUIGlobals.ROUTE_PORTFOLIO_STOCK_SYMBOL_INFO)]
@inherits BasePage

<SectionContent SectionId="MainLayout.Breadcrumb">
    <li class="breadcrumb-item">
        <a href="@UIGlobals.ROUTE_HOME">Home</a>
    </li>
    <li class="breadcrumb-item active">
        <span>@PAGE_TITLE</span>
    </li>
</SectionContent>

<AuthorizeView>
    <Authorizing>
        <AuthorizingView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Authorizing...")" />
    </Authorizing>
    <NotAuthorized>
        <NotAuthorizedView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Not Authorized")" LoginUrl="@LoginUrl" />
    </NotAuthorized>
    <Authorized>
		<PageTitle>@PAGE_TITLE | @AppInfo?.Name v@(AppInfo?.Version)</PageTitle>
        <div class="container-lg px-4">
            <div class="card border-top-primary border-top-3 mb-4">
                <div class="card-header">
					<div class="row float-start">
						<h4 class="card-title">
							@(SymbolInfo==null?"Stock Symbol Info":SymbolCode)
							<small class="text-muted">@(SymbolInfo?.Overview?.LongName??"")</small>
						</h4>
					</div>
					<div class="row float-end">
						<div class="col-auto m-1 g-0">
							<input type="text" class="form-control form-control-sm" placeholder="Symbol Code" @bind="SymbolCode" />
						</div>
						<div class="col-auto m-1 g-0">
							<select class="form-select form-select-sm" id="numDecimals" @bind="MarketId">
								<option value="">-= Markets =-</option>
								@foreach (var m in Markets)
								{
									<option value="@m.Id">@m.Code</option>
								}
							</select>
						</div>
						<div class="col-auto m-1 g-0">
							<button type="button" class="btn btn-sm btn-outline-primary" @onclick="BtnClickLoadData" title="Load data">
								<CIcon icon="sync" />
							</button>
							@if (!string.IsNullOrEmpty(PortfolioId))
							{
								<button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="BtnClickReturnToPortfolio" title="Return to portfolio">
									<BIcon icon="arrow-return-left" />
								</button>
							}
						</div>
					</div>
                </div>
                <div class="card-body">
					<CAlert @ref="@Alert" />
					@if (!HideUI)
					{
						@if (SymbolInfo == null)
						{
							<CAlert Type="warning">
								No stock symbol information loaded. Please enter a symbol code and select a market, then click the load button.
							</CAlert>
						}
						else
						{
							<div class="container">
								<!-- Header -->
								<div class="d-flex justify-content-between align-items-center mb-4">
									<div>
										<h2 class="mb-0">
											@(PortfolioUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketPrice??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
											<small style="font-size: large !important;" class="@(new string[]{"text-danger", "text-muted", "text-success"}[(SymbolInfo.StockQuote?.MarketPriceStatus??0)+1]) fw-semibold">
												@(
													(SymbolInfo.StockQuote?.MarketPriceChange??0) >= 0 ? "+" : ""
												)@(PortfolioUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketPriceChange??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
												(@(
													(SymbolInfo.StockQuote?.MarketPriceChange??0) >= 0 ? "+" : ""
												)@((SymbolInfo.StockQuote?.MarketPriceChangePercent??0).ToString("N2"))%)
											</small>
										</h2>
										<small class="text-muted">@(SymbolInfo.Exchange) • @(SymbolInfo.Currency) • @(Market?.IsCurrentlyOpen()??false?"Market Open":"Market Close"??"Unknown")</small>
									</div>
								</div>

								<!-- Chart + Key metrics -->
								<div class="row g-3 mb-4">
									<div class="col-lg-8">
										<div class="card h-100" style="min-height: 440px !important;">
											<div class="card-body p-0">
												<div class="bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center h-100">
													<CStockChart
														Symbol="@SymbolCode"
														Market="@Market"
														Exchange="@SymbolInfo.Exchange"
													/>
												</div>
											</div>
										</div>
									</div>

									<div class="col-lg-4">
										<div class="card h-100">
											<div class="card-body">
												<table class="table table-sm mb-0">
													<tr class="text-success">
														<td>Bid / Size</td>
														<td class="text-end">
															@(PortfolioUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.Bid??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
															/
															@((SymbolInfo.StockQuote?.BidSize??0) > 0
																? PortfolioUtils.FormatVolume(SymbolInfo.StockQuote?.BidSize??0)
																: "--"
															)
														</td>
													</tr>
													<tr class="text-danger">
														<td>Ask / Size</td>
														<td class="text-end">
															@(PortfolioUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.Ask??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
															/
															@((SymbolInfo.StockQuote?.AskSize??0) > 0
																? PortfolioUtils.FormatVolume(SymbolInfo.StockQuote?.AskSize??0)
																: "--"
															)
														</td>
													</tr>
													<tr>
														<td>Volume</td>
														<td class="text-end">
															@(PortfolioUtils.FormatVolume(SymbolInfo.StockQuote?.MarketVolume??0))
														</td>
													</tr>
													<tr>
														<td>Market Cap</td>
														<td class="text-end">
															@(PortfolioUtils.FormatVolume(SymbolInfo.StockQuote?.MarketCap??0))
														</td>
													</tr>
													<tr>
														<td>Day's Range</td>
														<td class="text-end">
															@(PortfolioUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketDayLow??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
															-
															@(PortfolioUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketDayHigh??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
														</td>
													</tr>
												</table>
											</div>
										</div>
									</div>
								</div>

								@*
								<!-- Detailed quote -->
								<div class="card">
									<div class="card-body">
										<h6 class="card-title">Quote Details</h6>
										<table class="table table-bordered table-sm mb-0">
											<tr><td>Previous Close</td><td>187.35</td></tr>
											<tr><td>Open</td><td>187.80</td></tr>
											<tr><td>Day High</td><td>190.10</td></tr>
											<tr><td>Day Low</td><td>187.50</td></tr>
											<tr><td>P/E Ratio</td><td>28.9</td></tr>
											<tr><td>Dividend Yield</td><td>0.52%</td></tr>
										</table>
									</div>
								</div>
								*@
							</div>
						}
                    }

					<div class="alert alert-warning mt-2" role="alert">
						<span style="font-size: small">@warningMsg</span>
					</div>

					@if (!string.IsNullOrEmpty(BackgroundMsg))
					{
						<div class="alert alert-light mt-2" role="alert">
							<span style="font-size: small !important;">@BackgroundMsg</span>
						</div>
					}
                </div>
            </div>
        </div>
	</Authorized>
</AuthorizeView>

@code {
    private const string PAGE_TITLE = "Stock Symbol Info";

	private string warningMsg = "Stock chart and data are provided by third-party services. " +
		"The application does not guarantee the accuracy, completeness, or timeliness of the information displayed. " +
		"Users should verify the data independently before making any investment decisions.";
}
