*@

					<div class="alert alert-warning mt-2" role="alert">
						<span style="font-size: small">@warningMsg</span>
					</div>

					@if (!string.IsNullOrEmpty(BackgroundMsg))
					{
						<div class="alert alert-light mt-2" role="alert">
							<span style="font-size: small !important;">@BackgroundMsg</span>
						</div>
					}
                </div>
            </div>
        </div>

		<CModal @ref="@ModalDialogAnalyzeSymbol" title="Analyze Symbol" centered="false" type="primary" size="extra-large">
			<div class="card">
				<div class="card-body">
					<CAlert @ref="@ModalDialogAnalyzeSymbol.Alert" />
					@if (AnalysisResponse.HasValue)
					{
						<WidgetMarkdownViewer Content="@AnalysisResponse.Value.Response" />
					}
				</div>
				@if (AnalysisResponse.HasValue)
				{
					<div class="card-footer">
						<small>@(AnalysisResponse.Value.IsCached?"(Cached) ":"")@((AnalysisResponse.Value.TotalTimeMs/1000m).ToString("F1"))s - Total Tokens: @(AnalysisResponse.Value.TotalTokens) (Prompt: @(AnalysisResponse.Value.NumTokensPrompt) / Thought: @(AnalysisResponse.Value.NumTokensThought) / Completion: @(AnalysisResponse.Value.NumTokensResponse))</small>
					</div>
				}
			</div>
		</CModal>
	</Authorized>
</AuthorizeView>

@code {
    private const string PAGE_TITLE = "Stock Symbol Info";

	private readonly string warningMsg = "Stock chart and data are provided by third-party services. " +
		"The application does not guarantee the accuracy, completeness, or timeliness of the information displayed. " +
		"Users should verify the data independently before making any investment decisions.";
}
