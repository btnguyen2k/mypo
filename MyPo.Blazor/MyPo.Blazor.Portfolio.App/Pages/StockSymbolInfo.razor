@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Blazor.Portfolio.App.Pages.Widgets
@using MyPo.Blazor.App.Layout
@using MyPo.Portfolio.Shared.Identity
@using MyPo.Portfolio.Shared.Utils

@attribute [Route(PortfolioUIGlobals.ROUTE_PORTFOLIO_STOCK_SYMBOL_INFO_EMPTY)]
@attribute [Route(PortfolioUIGlobals.ROUTE_PORTFOLIO_STOCK_SYMBOL_INFO)]
@inherits BasePage

<SectionContent SectionId="MainLayout.Breadcrumb">
    <li class="breadcrumb-item">
        <a href="@UIGlobals.ROUTE_HOME">Home</a>
    </li>
    <li class="breadcrumb-item active">
        <span>@PAGE_TITLE</span>
    </li>
</SectionContent>

<AuthorizeView>
    <Authorizing>
        <AuthorizingView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Authorizing...")" />
    </Authorizing>
    <NotAuthorized>
        <NotAuthorizedView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Not Authorized")" LoginUrl="@LoginUrl" />
    </NotAuthorized>
    <Authorized>
        <PageTitle>@PAGE_TITLE | @AppInfo?.Name v@(AppInfo?.Version)</PageTitle>
        <div class="container-lg px-4">
            <div class="card border-top-primary border-top-3 mb-4">
                <div class="card-header">
                    <div class="row float-start">
                        <h4 class="card-title">
                            @(SymbolInfo?.NormalizedSymbol??"Stock Symbol Info")
                            <small class="text-muted">@(SymbolInfo?.LongName??"")</small>
                        </h4>
                    </div>
                    <div class="row float-end">
                        <div class="col-auto m-1 g-0">
                            <input type="text" class="form-control form-control-sm" placeholder="Symbol Code" @bind="Symbol" />
                        </div>
                        <div class="col-auto m-1 g-0">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="BtnClickLoadData" title="Load data">
                                <CIcon icon="sync" />
                            </button>
                            @if (!string.IsNullOrEmpty(PortfolioId))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="BtnClickReturnToPortfolio" title="Return to portfolio">
                                    <BIcon icon="arrow-return-left" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <CAlert @ref="@Alert" />
                    @if (!HideUI)
                    {
                        @if (SymbolInfo == null)
                        {
                            <CAlert Type="warning">
                                No stock symbol information loaded. Please enter a symbol code and select a market, then click the load button.
                            </CAlert>
                        }
                        else
                        {
                            <div class="container">
                                <!-- Header -->
                                <div class="row g-3 mb-4">
                                    <div class="col-md-5 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h2 class="mb-0">
                                                @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketPrice??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                <small style="font-size: large !important;" class="@(new string[]{"text-danger", "text-muted", "text-success"}[(SymbolInfo.StockQuote?.MarketPriceStatus??0)+1]) fw-semibold">
                                                    @(
                                                        (SymbolInfo.StockQuote?.MarketPriceChange??0) >= 0 ? "+" : ""
                                                    )@(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketPriceChange??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                    (@(
                                                        (SymbolInfo.StockQuote?.MarketPriceChange??0) >= 0 ? "+" : ""
                                                    )@((SymbolInfo.StockQuote?.MarketPriceChangePercent??0).ToString("N2"))%)
                                                </small>
                                            </h2>
                                            <small class="text-muted">@(SymbolInfo.Exchange) • @(SymbolInfo.Currency) • @((Market?.IsCurrentlyOpen()??false)?"Market Open":"Market Close")</small>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        @if(OwningAsset != null)
                                        {
                                            <div class="card text-center">
                                                <div class="card-body">
                                                    <small class="text-muted">Position / Avg. Price</small>
                                                    <div class="fw-semibold @(OwningAsset.AveragePrice>(SymbolInfo.StockQuote?.MarketPrice??0)?"text-danger":"text-success")">
                                                        @(OwningAsset.Quantity.ToString(Market?.QuantityFormat??"N2"))
                                                        /
                                                        @(FormatUtils.FormatValueWithScale(OwningAsset.AveragePrice, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-2">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <small class="text-muted">Bid / Size</small>
                                                <div class="fw-semibold text-success">
                                                    @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.Bid??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                    /
                                                    @((SymbolInfo.StockQuote?.BidSize??0) > 0
                                                        ? FormatUtils.FormatVolume(SymbolInfo.StockQuote?.BidSize??0)
                                                        : "--"
                                                    )
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <small class="text-muted">Ask / Size</small>
                                                <div class="fw-semibold text-danger">
                                                    @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.Ask??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                    /
                                                    @((SymbolInfo.StockQuote?.AskSize??0) > 0
                                                        ? FormatUtils.FormatVolume(SymbolInfo.StockQuote?.AskSize??0)
                                                        : "--"
                                                    )
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Chart + Key metrics -->
                                <div class="row g-3 mb-4">
                                    <div class="col-lg-8">
                                        <div class="card h-100" style="min-height: 440px !important;">
                                            <div class="card-body p-0">
                                                <div class="bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center h-100">
                                                    <CStockChart SymbolInfo="@SymbolInfo" Market="@Market" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="card h-100">
                                            <div class="card-body">
                                                <table class="table table-sm mb-0">
                                                    <tr>
                                                        <td>Volume</td>
                                                        <td class="text-end">
                                                            @(FormatUtils.FormatVolume(SymbolInfo.StockQuote?.MarketVolume??0))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Market Cap</td>
                                                        <td class="text-end">
                                                            @(FormatUtils.FormatVolume(SymbolInfo.StockQuote?.MarketCap??0))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Day's Range</td>
                                                        <td class="text-end">
                                                            @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketDayLow??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                            -
                                                            @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.MarketDayHigh??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>52 Week Range</td>
                                                        <td class="text-end">
                                                            @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.FiftyTwoWeekLow??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                            -
                                                            @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.FiftyTwoWeekHigh??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Trailing EPS</td>
                                                        <td class="text-end">
                                                            @((SymbolInfo.StockQuote?.TrailingEps??0).ToString("N2"))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Forward EPS</td>
                                                        <td class="text-end @(new string[]{"text-danger", "", "text-success"}[1+SymbolInfo.StockQuote?.EpsStatus??0])">
                                                            @((SymbolInfo.StockQuote?.ForwardEps??0).ToString("N2"))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Trailing P/E</td>
                                                        <td class="text-end">
                                                            @((SymbolInfo.StockQuote?.TrailingPE??0).ToString("N2"))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Forward P/E</td>
                                                        <td class="text-end">
                                                            @((SymbolInfo.StockQuote?.ForwardPE??0).ToString("N2"))
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Beta</td>
                                                        <td class="text-end">
                                                            @((SymbolInfo.StockQuote?.Beta??0).ToString("N2"))
                                                        </td>
                                                    </tr>
                                                </table>

                                                <hr class="mt-1 mb-1" />

                                                <table class="table table-sm mb-0">
                                                    <tr>
                                                        <td>Analyst Recommendation</td>
                                                        <td class="text-end @(PortfolioUtils.BootstrapCssClassForAnalystRecommendation(SymbolInfo.StockQuote?.RecommendationKey??string.Empty))">
                                                            @((SymbolInfo.StockQuote?.RecommendationKey??string.Empty) switch
                                                                {
                                                                    "strong_buy" => "Strong Buy",
                                                                    "buy" => "Buy",
                                                                    "hold" => "Hold",
                                                                    "sell" => "Sell",
                                                                    "strong_sell" => "Strong Sell",
                                                                    _ => "--",
                                                                }
                                                            )
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Target Range</td>
                                                        <td class="text-end">
                                                            <span class="@(PortfolioUtils.BootstrapCssClassForTargetValue(
                                                                    SymbolInfo.StockQuote?.TargetLowPrice??0,
                                                                    SymbolInfo.StockQuote?.MarketPrice??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekLow??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekHigh??0))">
                                                                @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.TargetLowPrice??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                            </span>
                                                            -
                                                            <span class="@(PortfolioUtils.BootstrapCssClassForTargetValue(
                                                                    SymbolInfo.StockQuote?.TargetHighPrice??0,
                                                                    SymbolInfo.StockQuote?.MarketPrice??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekLow??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekHigh??0))">
                                                                @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.TargetHighPrice??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Target Mean / Median</td>
                                                        <td class="text-end">
                                                            <span class="@(PortfolioUtils.BootstrapCssClassForTargetValue(
                                                                    SymbolInfo.StockQuote?.TargetMeanPrice??0,
                                                                    SymbolInfo.StockQuote?.MarketPrice??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekLow??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekHigh??0))">
                                                                @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.TargetMeanPrice??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                            </span>
                                                            /
                                                            <span class="@(PortfolioUtils.BootstrapCssClassForTargetValue(
                                                                    SymbolInfo.StockQuote?.TargetMedianPrice??0,
                                                                    SymbolInfo.StockQuote?.MarketPrice??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekLow??0,
                                                                    SymbolInfo.StockQuote?.FiftyTwoWeekHigh??0))">
                                                                @(FormatUtils.FormatRawValueWithScale(SymbolInfo.StockQuote?.TargetMedianPrice??0, Market?.PriceScale??0, Market?.ValueFormat??"N2"))
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </table>

                                                <hr class="mt-1 mb-1" />

                                                <table class="table table-sm mb-0">
                                                    <tr>
                                                        <td colspan="2">Intent:</td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="2">
                                                            <textarea class="form-control form-control-sm" @bind="Intent" id="intent" placeholder="e.g. Should I hold, sell,% or buy"></textarea>
                                                        </td>
                                                    </tr>
                                                    <tr class="mt-1">
                                                        <td>&nbsp;</td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-block btn-sm btn-outline-primary mt-1" @onclick="BtnClickAIAnalyze" title="Run AI Analysis">
                                                                <BIcon icon="graph-up-arrow" extraClassName="me-1"/>Run AI Analysis
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Detailed quote -->
                                <div class="card">
                                    <div class="card-body">
                                        <table class="table table-bordered table-sm mb-0">
                                            <tr>
                                                <td class="col-4">Dividend Yield</td>
                                                <td class="col-2 text-end fw-semibold pe-4">@((SymbolInfo.Dividend?.DividendYield??0) > 0
                                                        ? SymbolInfo.Dividend?.DividendYield.ToString("N2")+"%"
                                                        : "--"
                                                    )</td>
                                                <td class="col-4">MA10</td>
                                                <td class="col-2 text-end fw-semibold @(PortfolioUtils.BootstrapCssClassForDelta(SymbolInfo.StockHistory?.MA10, SymbolInfo.StockQuote?.MarketPrice))">
                                                    @((SymbolInfo.StockHistory?.MA10??0) > 0
                                                        ? FormatUtils.FormatRawValueWithScale(SymbolInfo.StockHistory?.MA10??0, Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                            + " ("
                                                                + (PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA10, SymbolInfo.StockQuote?.MarketPrice)>=0?"+":"")
                                                                + FormatUtils.FormatRawValueWithScale(PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA10, SymbolInfo.StockQuote?.MarketPrice), Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                                + ")"
                                                        : "--"
                                                    )</td>
                                            </tr>
                                            <tr>
                                                <td class="col-4">Annual Dividend</td>
                                                <td class="col-2 text-end fw-semibold pe-4">@((SymbolInfo.Dividend?.DividendRate??0) > 0
                                                        ? FormatUtils.FormatValueWithScale(SymbolInfo.Dividend?.DividendRate??0, Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                        : "--"
                                                    )</td>
                                                <td class="col-4">MA20</td>
                                                <td class="col-2 text-end fw-semibold @(PortfolioUtils.BootstrapCssClassForDelta(SymbolInfo.StockHistory?.MA20, SymbolInfo.StockQuote?.MarketPrice))">
                                                    @((SymbolInfo.StockHistory?.MA20??0) > 0
                                                        ? FormatUtils.FormatRawValueWithScale(SymbolInfo.StockHistory?.MA20??0, Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                            + " ("
                                                                + (PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA20, SymbolInfo.StockQuote?.MarketPrice)>=0?"+":"")
                                                                + FormatUtils.FormatRawValueWithScale(PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA20, SymbolInfo.StockQuote?.MarketPrice), Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                                + ")"
                                                        : "--"
                                                    )</td>
                                            </tr>
                                            <tr>
                                                <td class="col-4">Ex-Dividend Date</td>
                                                <td class="col-2 text-end fw-semibold pe-4">@((SymbolInfo.Dividend?.ExDividendTimestamp??0) > 0
                                                        ? DateTimeOffset.FromUnixTimeSeconds(SymbolInfo.Dividend?.ExDividendTimestamp??0).ToString("MMM dd, yyyy")
                                                        : "--"
                                                    )</td>
                                                <td class="col-4">MA50</td>
                                                <td class="col-2 text-end fw-semibold @(PortfolioUtils.BootstrapCssClassForDelta(SymbolInfo.StockHistory?.MA50, SymbolInfo.StockQuote?.MarketPrice))">
                                                    @((SymbolInfo.StockHistory?.MA50??0) > 0
                                                        ? FormatUtils.FormatRawValueWithScale(SymbolInfo.StockHistory?.MA50??0, Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                            + " ("
                                                                + (PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA50, SymbolInfo.StockQuote?.MarketPrice)>=0?"+":"")
                                                                + FormatUtils.FormatRawValueWithScale(PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA50, SymbolInfo.StockQuote?.MarketPrice), Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                                + ")"
                                                        : "--"
                                                    )</td>
                                            </tr>
                                            <tr>
                                                <td class="col-4">Last Dividend</td>
                                                <td class="col-2 text-end fw-semibold pe-4">@((SymbolInfo.Dividend?.LastDividendValue??0) > 0
                                                        ? FormatUtils.FormatValueWithScale(SymbolInfo.Dividend?.LastDividendValue??0, Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                        : "--"
                                                    )</td>
                                                <td class="col-4">MA100</td>
                                                <td class="col-2 text-end fw-semibold @(PortfolioUtils.BootstrapCssClassForDelta(SymbolInfo.StockHistory?.MA100, SymbolInfo.StockQuote?.MarketPrice))">
                                                    @((SymbolInfo.StockHistory?.MA100??0) > 0
                                                        ? FormatUtils.FormatRawValueWithScale(SymbolInfo.StockHistory?.MA100??0, Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                            + " ("
                                                                + (PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA100, SymbolInfo.StockQuote?.MarketPrice)>=0?"+":"")
                                                                + FormatUtils.FormatRawValueWithScale(PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA100, SymbolInfo.StockQuote?.MarketPrice), Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                                + ")"
                                                        : "--"
                                                    )</td>
                                            </tr>
                                            <tr>
                                                <td class="col-4">Last Dividend Date</td>
                                                <td class="col-2 text-end fw-semibold pe-4">@((SymbolInfo.Dividend?.LastDividendTimestamp??0) > 0
                                                        ? DateTimeOffset.FromUnixTimeSeconds(SymbolInfo.Dividend?.LastDividendTimestamp??0).ToString("MMM dd, yyyy")
                                                        : "--"
                                                    )</td>
                                                <td class="col-4">MA200</td>
                                                <td class="col-2 text-end fw-semibold @(PortfolioUtils.BootstrapCssClassForDelta(SymbolInfo.StockHistory?.MA200, SymbolInfo.StockQuote?.MarketPrice))">
                                                    @((SymbolInfo.StockHistory?.MA200??0) > 0
                                                        ? FormatUtils.FormatRawValueWithScale(SymbolInfo.StockHistory?.MA200??0, Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                            + " ("
                                                                + (PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA200, SymbolInfo.StockQuote?.MarketPrice)>=0?"+":"")
                                                                + FormatUtils.FormatRawValueWithScale(PortfolioUtils.Delta(SymbolInfo.StockHistory?.MA200, SymbolInfo.StockQuote?.MarketPrice), Market?.PriceScale??0, Market?.ValueFormat??"N2")
                                                                + ")"
                                                        : "--"
                                                    )</td>
                                            </tr>
                                            <tr>
                                                <td class="col-4">5-year Avg. Dividend Yield</td>
                                                <td class="col-2 text-end fw-semibold pe-4">@((SymbolInfo.Dividend?.FiveYearAvgDividendYield??0) > 0
                                                        ? SymbolInfo.Dividend?.FiveYearAvgDividendYield.ToString("N2")+"%"
                                                        : "--"
                                                    )</td>
                                                <td class="col-4">RSI-14</td>
                                                <td class="col-2 text-end fw-semibold">
                                                    @((SymbolInfo.StockHistory?.RSI14??0) > 0
                                                        ? SymbolInfo.StockHistory?.RSI14.ToString("N2")
                                                        : "--"
                                                    )</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <div class="alert alert-warning mt-2" role="alert">
                        <span style="font-size: small">@warningMsg</span>
                    </div>

                    @if (!string.IsNullOrEmpty(BackgroundMsg))
                    {
                        <div class="alert alert-light mt-2" role="alert">
                            <span style="font-size: small !important;">@BackgroundMsg</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <CModal @ref="@ModalDialogAnalyzeSymbol" title="Analyze Symbol" centered="false" type="primary" size="extra-large">
            <div class="card">
                <div class="card-body">
                    <CAlert @ref="@ModalDialogAnalyzeSymbol.Alert" />
                    @if (TickerAnalysis is not null)
                    {
                        <WidgetMarkdownViewer Content="@TickerAnalysis.Analysis" />
                    }
                </div>
                @if (TickerAnalysis is not null)
                {
                    <div class="card-footer">
                        @* <small>@(AnalysisResponse.Value.IsCached?"(Cached) ":"")@((AnalysisResponse.Value.TotalTimeMs/1000m).ToString("F1"))s - Total Tokens: @(AnalysisResponse.Value.TotalTokens) (Prompt: @(AnalysisResponse.Value.NumTokensPrompt) / Thought: @(AnalysisResponse.Value.NumTokensThought) / Completion: @(AnalysisResponse.Value.NumTokensResponse))</small> *@
                    </div>
                }
            </div>
        </CModal>
    </Authorized>
</AuthorizeView>

@code {
    private const string PAGE_TITLE = "Stock Symbol Info";

    private readonly string warningMsg = "Stock chart and data are provided by third-party services. " +
        "The application does not guarantee the accuracy, completeness, or timeliness of the information displayed. " +
        "Users should verify the data independently before making any investment decisions.";
}
