@using MyPo.Libs
@using MyPo.Blazor.App.Layout
@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Blazor.Portfolio.App.Pages.PortfolioDetails
@using MyPo.Portfolio.Shared.Api
@using MyPo.Portfolio.Shared.Identity
@using MyPo.Portfolio.Shared.Utils

@attribute [Route(PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_PLANS_VIEW)]
@inherits BasePage

<SectionContent SectionId="MainLayout.Breadcrumb">
    <li class="breadcrumb-item">
        <a href="@UIGlobals.ROUTE_HOME">Home</a>
    </li>
	<li class="breadcrumb-item">
        <a href="@PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_PLANS">My Portfolio Plans</a>
    </li>
    <li class="breadcrumb-item active">
        <span>@(SelectedPortfolioPlan?.Name ?? PlanId)</span>
    </li>
</SectionContent>

<AuthorizeView>
	<Authorizing>
        <AuthorizingView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Authorizing...")" />
    </Authorizing>
    <NotAuthorized>
        <NotAuthorizedView PageTitle="@($"{PAGE_TITLE} | {AppInfo?.Name} v{AppInfo?.Version} - Not Authorized")" LoginUrl="@LoginUrl" />
    </NotAuthorized>
    <Authorized>
        <PageTitle>@PAGE_TITLE | @AppInfo?.Name v@(AppInfo?.Version)</PageTitle>
        <div class="container-lg px-4">
			<div class="card border-top-primary border-top-3 mb-4">
				<div class="card-header">
                    <h4 class="card-title float-start">@(SelectedPortfolioPlan?.Name ?? PlanId)</h4>
					@if (!HideUI)
					{
						<AuthorizeView Policy="@PortfolioPolicies.POLICY_NAME_ADMIN_ROLE_OR_PORTFOLIO_MANAGER">
							<ChildContent Context="ctx_edit_delete_portfolio_plan">
								<div class="float-end">
									<button class="btn btn-outline-primary btn-sm" @onclick="BtnClickEdit"><BIcon icon="bi-pencil" extraClassName="me-1"/>Edit</button>
									<button class="btn btn-outline-danger btn-sm" @onclick="BtnClickDelete"><BIcon icon="bi-trash" extraClassName="me-1"/>Delete</button>
								</div>
							</ChildContent>
						</AuthorizeView>
					}
                </div>
                <div class="card-body">
					<CAlert @ref="@Alert" />
					@if (!HideUI)
					{
						<div class="d-flex justify-content-between align-items-start mb-4">
							<div>
								@if(SelectedPortfolioPlan?.Metadata is not null && !string.IsNullOrEmpty(SelectedPortfolioPlan.Metadata.Description))
								{
									<p class="text-muted mb-1">@(SelectedPortfolioPlan.Metadata.Description.SingleLine())</p>
								}
								<p class="text-muted small mb-0">
									@if (SelectedPortfolioPlan?.Portfolio is not null)
									{
										<BIcon icon="bi-link-45deg" extraClassName="me-1" />@($"{SelectedPortfolioPlan.Portfolio.Name} | ")
									}
									Refreshed @((SelectedPortfolioPlan?.Metadata?.HoldingsRefreshUTC.ToString("MMM-dd HH:mm")+" UTC")??"N/A")
								</p>
								@*
								@if (SelectedPortfolioPlan?.Portfolio is not null)
								{
									<p class="text-muted small mb-0 mt-1">
										<BIcon icon="bi-link-45deg" extraClassName="me-1" />@(SelectedPortfolioPlan.Portfolio.Name)
									</p>
								}
								*@
							</div>
						</div>

						<!-- Summary cards -->
						<div class="row g-3 mb-4">
							<div class="col-sm-6 col-lg-3">
								<div class="card text-center">
									<div class="card-body py-3">
										<div class="text-muted small">Total Value</div>
										<div class="h5 mb-0">@(SelectedPortfolioPlan?.TotalMarketValueStr()??"--")</div>
									</div>
								</div>
							</div>
							<div class="col-sm-6 col-lg-3">
								<div class="card text-center">
									<div class="card-body py-3">
										<div class="text-muted small">Est. Yearly Dividend</div>
										<div class="h5 mb-0">@SelectedPortfolioPlan?.EstTotalYearlyDividendStr() (@SelectedPortfolioPlan?.EstTotalYearlyDividendYieldStr())</div>
									</div>
								</div>
							</div>
							<div class="col-sm-6 col-lg-3">
								<div class="card text-center">
									<div class="card-body py-3">
										<div class="text-muted small">Max Overweight</div>
										<div class="h5 mb-0 @(devCssClass(SelectedPortfolioPlan?.MaxAllocationDiffPct??0))">@(SelectedPortfolioPlan?.MaxAllocationDiffPctStr())</div>
									</div>
								</div>
							</div>
							<div class="col-sm-6 col-lg-3">
								<div class="card text-center">
									<div class="card-body py-3">
										<div class="text-muted small">Max Underweight</div>
										<div class="h5 mb-0 @(devCssClass(SelectedPortfolioPlan?.MinAllocationDiffPct??0))">@(SelectedPortfolioPlan?.MinAllocationDiffPctStr()??"--")</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Holdings detail table -->
						<div class="card">
							<div class="card-header bg-transparent d-flex justify-content-between align-items-center">
								<h2 class="h6 mb-0">Holdings Breakdown</h2>
								<span class="badge bg-secondary">@(SelectedPortfolioPlan?.Metadata?.HoldingTickers?.Count) symbols</span>
							</div>
							<div class="table-responsive">
								<style>
								.allocation-bar {
									position: relative;
									height: 16px;
									border-radius: 4px;
									overflow: hidden;
									background: var(--cui-secondary-bg);
								}

								.allocation-bar .bar-current {
									height: 100%;
									transition: width .4s ease;
								}

								.allocation-bar .bar-target {
									position: absolute;
									top: 0;
									height: 100%;
									width: 2px;
									background: var(--cui-dark);
								}
								</style>
								<table class="table table-hover align-middle mb-0">
									<thead>
										<tr>
											<th>Ticker</th>
											<th class="text-end">Shares</th>
											<th class="text-end">Price</th>
											<th class="text-end">Market Value</th>
											<th class="text-end">Div Yield</th>
            								<th class="text-end">Est. Yearly Div</th>
											<th class="text-end">Current %</th>
											<th class="text-end">Target %</th>
											<th class="text-end">Deviation</th>
											<th style="width:200px">Allocation</th>
										</tr>
									</thead>
									<tbody class="table-group-divider">
										@foreach (var ht in SelectedPortfolioPlan?.Metadata?.HoldingTickers??[])
										{
											<tr>
												<td title="@ht.Tags">@FormatUtils.ExtractFirstCharIfEmoji(ht.Tags)@ht.Ticker</td>
												<td class="text-end">@SelectedPortfolioPlan?.NumSharesStr(ht)</td>
												<td class="text-end">@SelectedPortfolioPlan?.MarketPriceStr(ht)</td>
												<td class="text-end">@SelectedPortfolioPlan?.MarketValueStr(ht)</td>
												<td class="text-end">@($"{ht.DividendYield:N1}%")</td>
												<td class="text-end">@SelectedPortfolioPlan?.EstYearlyDividendStr(ht)</td>
												<td class="text-end">@SelectedPortfolioPlan?.CurrentAllocationPct(ht).ToString("N1")%</td>
												<td class="text-end">@SelectedPortfolioPlan?.TargetAllocationPct(ht).ToString("N0")%</td>
												<td class="text-end @(devCssClass(SelectedPortfolioPlan?.AllocationDiffPct(ht)??0))">@SelectedPortfolioPlan?.AllocationDiffPct(ht).ToString("N1")%</td>
												<td>
													@*
													<div class="progress" style="height: 16px;">
														<div class="progress-bar bg-primary" role="progressbar" style="width: @(SelectedPortfolioPlan?.CurrentAllocationPct(ht)??0)%" aria-valuenow="@(SelectedPortfolioPlan?.CurrentAllocationPct(ht)??0)" aria-valuemin="0" aria-valuemax="100"></div>
														<div class="progress-bar bg-secondary" role="progressbar" style="width: @(SelectedPortfolioPlan?.TargetAllocationPct(ht)??0)%" aria-valuenow="@(SelectedPortfolioPlan?.TargetAllocationPct(ht)??0)" aria-valuemin="0" aria-valuemax="100"></div>
													</div>
													*@
													<div class="allocation-bar" title="Current @(SelectedPortfolioPlan?.CurrentAllocationPct(ht).ToString("N1"))% / Target @(SelectedPortfolioPlan?.TargetAllocationPct(ht).ToString("N0"))% / Need @(SelectedPortfolioPlan?.AmoutNeededToFillDeviationStr(ht)) (@SelectedPortfolioPlan?.SharesNeededToFillDeviationStr(ht) shares)">
														<div class="bar-current @(barCssClass(SelectedPortfolioPlan?.AllocationDiffPct(ht)??0))" style="width:@(SelectedPortfolioPlan?.CurrentAllocationPct(ht)??0)%"></div>
														<div class="bar-target" style="left:@(SelectedPortfolioPlan?.TargetAllocationPct(ht)??0)%" title="Target @(SelectedPortfolioPlan?.TargetAllocationPct(ht).ToString("N0"))%"></div>
													</div>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					}
				</div>
			</div>
		</div>

		<CModal @ref="@ModalDialogDelete" title="Delete Portfolio Plan" centered="false" type="danger" size="large">
			<div class="card">
				<div class="card-body">
					<CAlert type="warning"><span class="h6">Are you sure you want to delete the following portfolio plan?</span></CAlert>
					<form>
						<div class="row">
							<div class="col-12">
								<div class="form-floating mb-1">
									<input type="text" class="form-control" id="pName" placeholder="Name" disabled value="@(SelectedPortfolioPlan?.Name)">
									<label for="pName">Name</label>
								</div>
							</div>
						</div>
					</form>
					<hr />
					<button type="button" class="btn btn-outline-secondary" @onclick="()=>BtnClickDeleteClose()">Cancel</button>
					<button type="button" class="btn btn-danger" @onclick="()=>BtnClickDeleteConfirm()"><BIcon icon="trash" extraClassName="me-1"/>Delete</button>
				</div>
			</div>
		</CModal>
	</Authorized>
</AuthorizeView>

@code {
    private const string PAGE_TITLE = "My Portfolio Plan";

	private string barCssClass(decimal dev)
	{
		var v = Math.Abs(dev);
		if (v <= 5)
		{
			return "bg-success bg-opacity-50";
		}
		if (v <= 11)
		{
			return "bg-info bg-opacity-75";
		}
		return "bg-danger bg-opacity-50";
	}

	private string devCssClass(decimal dev)
	{
		var v = Math.Abs(dev);
		if (v <= 1)
		{
			return "text-muted";
		}
		if (v <= 3)
		{
			return "text-success";
		}
		if (v <= 7)
		{
			return "text-info";
		}
		return "text-danger";
	}
}
