<div class="card border-top-success border-top-3 mb-4">
	<div class="card-header align-items-center">
		<h5 class="card-title float-start">Sell With Fee</h5>
		<div class="row float-end">
			<div class="col-auto">
				<label for="numDecimals" class="form-label">Decimals:</label>
			</div>
			<div class="col-auto">
				<select class="form-select form-select-sm" id="numDecimals" @bind="numDecimals">
					<option value="N0">0</option>
					<option value="N1">1</option>
					<option value="N2">2</option>
					<option value="N3">3</option>
					<option value="N4">4</option>
					<option value="N5">5</option>
					<option value="N6">6</option>
				</select>
			</div>
		</div>
	</div>
	<div class="card-body">
		<div class="row">
			<div class="col-md-4 col-sm-12">
				<label for="numUnits" class="form-label">Num Units:</label>
				<div class="input-group input-group-sm">
					<input type="number" min="1" step="1" class="form-control" id="numUnits" placeholder="Units to sell" @bind="NumUnits" />
				</div>
			</div>
			<div class="col-md-4 col-sm-12">
				<label for="unitPrice" class="form-label">Unit Price:</label>
				<div class="input-group input-group-sm">
					<span class="input-group-text">💵</span>
					<input type="number" min="@MinValue" step="@Step" class="form-control" id="unitPrice" placeholder="Unit price"
						value="@UnitPrice.ToString(numDecimals)" @onchange="(e)=>{UnitPrice=decimal.TryParse(e.Value?.ToString(), out var v)?v:0;}" />
				</div>
			</div>
			<div class="col-md-4 col-sm-12">
				<label for="txFee" class="form-label">Tx Fee:</label>
				<div class="input-group input-group-sm">
					<span class="input-group-text">💵</span>
					<input type="number" min="@MinValue" step="@Step" class="form-control" id="txFee" placeholder="Transaction fee"
						value="@TxFee.ToString(numDecimals)" @onchange="(e)=>{TxFee=decimal.TryParse(e.Value?.ToString(), out var v)?v:0;}" />
				</div>
			</div>
		</div>
		<div class="row mt-2">
			<div class="col-md-4 col-sm-12">
				<label for="totalReturn" class="form-label">Total Return:</label>
				<div class="input-group input-group-sm">
					<span class="input-group-text">💵</span>
					<input type="text" class="form-control fw-medium" id="totalReturn" disabled value="@(TotalReturn.ToString(numDecimals))"/>
				</div>
			</div>
			<div class="col-md-4 col-sm-12">
				<label for="effectiveUnitPrice" class="form-label">Effective Unit Price:</label>
				<div class="input-group input-group-sm">
					<span class="input-group-text">💵</span>
					<input type="text" class="form-control fw-bolder" id="effectiveUnitPrice" disabled value="@(EffectiveUnitPrice.ToString(numDecimals))"/>
				</div>
			</div>
			<div class="col-md-4 col-sm-12">
				<label for="breakEven" class="form-label">Break-even:</label>
				<div class="input-group input-group-sm">
					<span class="input-group-text">%</span>
					<input type="text" class="form-control fw-bolder" id="breakEven" disabled value="@(BreakEven.ToString("N2"))"/>
				</div>
			</div>
		</div>
		<hr />
		<div class="row mt-2">
			<div class="col-md-6 col-sm-12">
				<label for="owningAvgPrice" class="form-label">Avg. Owning Price:</label>
				<div class="input-group input-group-sm">
					<span class="input-group-text">💵</span>
					<input type="number" min="@MinValue" step="@Step" class="form-control" id="owningAvgPrice" placeholder="Average Price of Owning Units"
						value="@OwningAvgPrice.ToString(numDecimals)" @onchange="(e)=>{OwningAvgPrice=decimal.TryParse(e.Value?.ToString(), out var v)?v:0;}" />
				</div>
			</div>
			<div class="col-md-6 col-sm-12">
				<label for="pnl" class="form-label">P/L:</label>
				<div class="input-group input-group-sm">
					<span class="input-group-text">💵</span>
					<input type="text" class="form-control fw-bolder @(pnl>=0?"text-success":"text-danger")" id="pnl" disabled value="@(pnl.ToString(numDecimals))"/>
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	private string numDecimals { get; set; } = "N2";

	[Parameter]
	public decimal NumUnits { get; set; } = 5m;

	[Parameter]
	public decimal UnitPrice { get; set; } = 120m;

	[Parameter]
	public decimal TxFee { get; set; } = 5.00m;
	private decimal TotalReturn => UnitPrice * NumUnits - TxFee;
	private decimal EffectiveUnitPrice => NumUnits > 0 ? TotalReturn/NumUnits : 0;
	private decimal BreakEven => UnitPrice > 0 && NumUnits > 0 ? (TotalReturn/NumUnits/UnitPrice-1)*100.00m : 0;

	[Parameter]
	public decimal OwningAvgPrice { get; set; } = 80m;
	private decimal pnl => (EffectiveUnitPrice - OwningAvgPrice) * NumUnits;
	private decimal MinValue => numDecimals switch
	{
		"N0" => 1m,
		"N1" => 0.1m,
		"N2" => 0.01m,
		"N3" => 0.001m,
		"N4" => 0.0001m,
		"N5" => 0.00001m,
		"N6" => 0.000001m,
		_ => 0.01m,
	};
	private decimal Step => MinValue;
}
