@using MyPo.Blazor.App.Shared

@inherits BaseComponent

@if (!string.IsNullOrEmpty(ErrorMessage))
{
	<CAlert type="danger">
		@ErrorMessage
	</CAlert>
}
else if (UseVietstockChart)
{
	<div class="container h-100 w-100 m-0 p-0 g-0">
		<iframe id="vietstock-frame-chart"
			src="https://stockchart.vietstock.vn/?stockcode=@(Symbol)&isIframe=1"
			style="width: 100%; height:100%;" scrolling="no" frameborder="0"></iframe>
	</div>
}
else if (UseTradingViewChart)
{
	<div class="container h-100 w-100 m-0 p-0 g-0">
		<iframe id="tradingview-frame-chart"
			src="https://s.tradingview.com/widgetembed/?symbol=@(string.IsNullOrEmpty(Exchange)?Symbol:$"{Exchange}:{Symbol}")&interval=D&hide_side_toolbar=0&withdateranges=1&saveimage=1&theme=light&timezone=@(Market?.TimeZone??"Etc/UTC")"
			style="width: 100%; height:100%;" scrolling="no" frameborder="0"></iframe>
	</div>

	@*
	<!-- TradingView Widget BEGIN -->
	<div class="container h-100 w-100 m-0 p-0 g-0">
		<div class="tradingview-widget-container h-100 w-100 m-0 p-0 g-0">
			<div class="tradingview-widget-container__widget" style="height:calc(100% - 32px);width:100%"></div>
			<div class="tradingview-widget-copyright"><a href="https://www.tradingview.com/symbols/@(Exchange)-@(Symbol)/" rel="noopener nofollow" target="_blank"><span class="blue-text">@(Symbol) stock chart</span></a><span class="trademark"> by TradingView</span></div>
			<script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async>
			{
				"allow_symbol_change": true,
				"calendar": true,
				"details": false,
				"hide_side_toolbar": true,
				"hide_top_toolbar": false,
				"hide_legend": false,
				"hide_volume": false,
				"hotlist": false,
				"interval": "D",
				"locale": "en",
				"save_image": true,
				"style": "1",
				"symbol": "@(Exchange):@(Symbol)",
				"theme": "dark",
				"timezone": "Etc/UTC",
				"backgroundColor": "#ffffff",
				"gridColor": "rgba(46, 46, 46, 0.06)",
				"watchlist": [],
				"withdateranges": true,
				"compareSymbols": [],
				"studies": [],
				"autosize": true
			}
			</script>
		</div>
	</div>
	<!-- TradingView Widget END -->
	*@
}
else
{
	<CAlert type="warning">
		No chart available for this stock symbol.
	</CAlert>
}

@code {

}
