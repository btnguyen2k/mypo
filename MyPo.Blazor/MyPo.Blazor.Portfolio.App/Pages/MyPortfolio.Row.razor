@using MyPo.Blazor.App.Shared
@using MyPo.Blazor.Portfolio.App.Pages
@using MyPo.Blazor.Portfolio.App.Pages.Widgets
@using MyPo.Blazor.Portfolio.App.Shared
@using MyPo.Portfolio.Shared.Api
@using MyPo.Portfolio.Shared.Models

@inherits CBase

@{
	var _indent = (MarkupString)(Level > 0 ? $"<span style=\"padding-left:{Level*1.25}rem\" class=\"d-inline-block\"></span>" : "");
	var _noShowIconIfNoChildren = Portfolio.Children?.Any()??false ? "" : "d-none";
	var _noShowIfActive = Portfolio.IsActive ? "d-none" : "";
	var p = Portfolio;
}

<tr class="@(p.IsActive?"":"text-muted opacity-50")" style="cursor:pointer;" @onclick="()=>BtnClickInfo(p.Id)">
	<td>
		@_indent<BIcon icon="bi-diagram-3" extraClassName="@($"text-muted me-1 {_noShowIconIfNoChildren}")"/><strong>@p.Name</strong><span class="badge bg-secondary badge-sm ms-1 @_noShowIfActive">Inactive</span>
		<br>
		@_indent<small class="text-muted">@(p.Description)</small>
	</td>
	<td class="text-center w-auto small"><CBadgeRandom Text="@p.Currency" /></td>
	@if(PortfolioPnlSummaryMap.TryGetValue(p.Id, out var pnlSummary))
	{
		<td class="text-end w-auto">
			@((DefaultMarket(p)?.CurrencySymbol??"--")+" ")
			@(pnlSummary.TotalIncome == 0
				? "--"
				: @FormatUtils.FormatValueWithScale(pnlSummary.TotalIncome, DefaultMarket(p)?.PriceScale??1, DefaultMarket(p)?.ValueFormat??"")
			)
		</td>
		<td class="text-end w-auto">
			@((DefaultMarket(p)?.CurrencySymbol??"--")+" ")
			@(pnlSummary.TotalCosts == 0
				? "--"
				: @FormatUtils.FormatValueWithScale(pnlSummary.TotalCosts, DefaultMarket(p)?.PriceScale??1, DefaultMarket(p)?.ValueFormat??"")
			)
		</td>
		<td class="text-end w-auto">
			@((DefaultMarket(p)?.CurrencySymbol??"--")+" ")
			@(pnlSummary.TotalBuyValue == 0
				? "--"
				: @FormatUtils.FormatValueWithScale(pnlSummary.TotalBuyValue, DefaultMarket(p)?.PriceScale??1, DefaultMarket(p)?.ValueFormat??"")
			)
		</td>
		<td class="text-end w-auto">
			@((DefaultMarket(p)?.CurrencySymbol??"--")+" ")
			@(pnlSummary.TotalSellValue == 0
				? "--"
				: @FormatUtils.FormatValueWithScale(pnlSummary.TotalSellValue, DefaultMarket(p)?.PriceScale??1, DefaultMarket(p)?.ValueFormat??"")
			)
		</td>
		<td class="text-end w-auto">
			@((DefaultMarket(p)?.CurrencySymbol??"--")+" ")
			@(p.TotalCosts == 0
				? "--"
				: @FormatUtils.FormatValueWithScale(p.TotalCosts, DefaultMarket(p)?.PriceScale??1, DefaultMarket(p)?.ValueFormat??"")
			)
		</td>
		<td class="text-end w-auto @(p.TotalPnl>0?"text-success":(p.TotalPnl<0?"text-danger":""))">
			@((DefaultMarket(p)?.CurrencySymbol??"--")+" ")
			@(p.TotalMarketValue == 0
				? "--"
				: @FormatUtils.FormatValueWithScale(p.TotalMarketValue, DefaultMarket(p)?.PriceScale??1, DefaultMarket(p)?.ValueFormat??"")
			)
		</td>
		<td class="text-end w-auto @(p.TotalPnl>0?"text-success":(p.TotalPnl<0?"text-danger":""))">
			@(p.TotalCosts == 0
				? "--"
				: p.TotalPnlPct.ToString("P2")
			)
		</td>
	}
	else
	{
		<td colspan="7" class="text-center">--</td>
	}
	<td class="text-center w-auto">
		<button class="btn btn-sm btn-outline-primary" @onclick="()=>BtnClickInfo(p.Id)" @onclick:preventDefault @onclick:stopPropagation>
			<BIcon icon="bi-info-lg" />
		</button>
		<button class="btn btn-sm @(p.OwnerUserId==CurrentUser?.Id?"btn-outline-info":"btn-outline-secondary")"
				disabled="@(p.OwnerUserId!=CurrentUser?.Id)"
				@onclick="()=>BtnClickModify(p.Id)" @onclick:preventDefault @onclick:stopPropagation>
			<BIcon icon="bi-pencil" />
		</button>
		<button class="btn btn-sm @(p.OwnerUserId==CurrentUser?.Id?"btn-outline-danger":"btn-outline-secondary")"
				disabled="@(p.OwnerUserId!=CurrentUser?.Id)"
				@onclick="BtnClickDelete" @onclick:preventDefault @onclick:stopPropagation>
			<BIcon icon="bi-trash" />
		</button>
	</td>
</tr>
@foreach (var child in p.Children??[])
{
	<MyPortfolio_Row
		Portfolio="child"
		Level="@(Level+1)"
		PortfolioPnlSummaryMap="PortfolioPnlSummaryMap"
		Markets="Markets" />
}

@code {
	[Parameter]
	public PortfolioResp Portfolio { get; set; } = default!;

	[Parameter]
	public int Level { get; set; } = 0;

	[Parameter]
	public  Dictionary<string, PnlSummaryResp> PortfolioPnlSummaryMap { get; set; } = default!;

	[Parameter]
	public List<MarketDefResp> Markets { get; set; } = default!;

	[Parameter]
	public MyPortfolio Page { get; set; } = default!;

	private MarketDefResp? DefaultMarket(PortfolioResp p)
	{
		return Markets.FirstOrDefault(m => m.Id.Equals(p.Metadata?.DefaultMarketId??"", StringComparison.OrdinalIgnoreCase));
	}

	private void BtnClickInfo(string pid)
	{
		NavigationManager.NavigateTo(PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_DETAILS.Replace("{PortfolioId}", pid, StringComparison.OrdinalIgnoreCase));
	}

	private void BtnClickModify(string pid)
	{
		NavigationManager.NavigateTo(PortfolioUIGlobals.ROUTE_PORTFOLIO_MY_PORTFOLIO_MODIFY.Replace("{PortfolioId}", pid, StringComparison.OrdinalIgnoreCase));
	}

	private void BtnClickDelete()
	{
		Page.OnClickDeletePortfolio(Portfolio);
	}
}
