@namespace MyPo.Blazor.App.Shared

<!--
Razor component to render CoreUI alert. Ref: https://coreui.io/bootstrap/docs/components/alerts/

Sample usage:
    <CAlert type="info">
        <span>Alert body text goes here.</span>
    </CAlert>
-->

<div class="alert @alertClass d-flex align-items-center fade" role="alert">
    <BIcon icon="@icon" extraClassName="@iconClass"/>
    <div>
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// Alert type, one of "wait" or "waiting", "info", "warning", "danger", "success", "primary", "secondary". Default is "info".
    /// The alert will display an icon corresponding to the type. The icon is taken from Bootstrap Icons.
    /// </summary>
    [Parameter]
    public string Type { get; set; } = string.Empty;

    // property name must be ChildContent
    [Parameter]
    public RenderFragment ChildContent { get; set; } = default!;

	private bool isVisible => !string.IsNullOrEmpty(Type);

	private DateTimeOffset? autoCloseTimestamp { get; set; } = null;

	public void Show(string alertType, string alertMessage, int autoCloseAfterMs = 0)
	{
		this.Type = alertType;
		this.ChildContent = builder =>
		{
			builder.AddContent(0, alertMessage);
		};
		StateHasChanged();
		if (autoCloseAfterMs > 0)
		{
			autoCloseTimestamp = DateTimeOffset.Now.AddMilliseconds(autoCloseAfterMs);
			Task.Run(async () =>
			{
				await Task.Delay(autoCloseAfterMs);
				if (autoCloseTimestamp != null && autoCloseTimestamp.Value <= DateTimeOffset.Now)
				{
					Hide();
				}
			});
		}
		else
		{
			autoCloseTimestamp = null;
		}
	}

	public void Hide()
	{
		this.Type = string.Empty;
		this.ChildContent = builder => { };
		this.autoCloseTimestamp = null;
		StateHasChanged();
	}

    private string icon => Type.ToLower() switch
        {
            "warning" => "bi-exclamation-triangle",
            "danger" => "x-circle-fill",
            "success" => "check-circle",
			"wait" or "waiting" => "bi-hourglass-split",
            _ => "bi-info-circle"
        };
    private string iconClass => Type.ToLower() switch
        {
            "warning" => "flex-shrink-0 me-2 text-warning",
            "danger" => "flex-shrink-0 me-2 text-danger",
            "success" => "flex-shrink-0 me-2 text-success",
            "primary" => "flex-shrink-0 me-2 text-primary",
            "secondary" => "flex-shrink-0 me-2 text-secondary",
            _ => "flex-shrink-0 me-2 text-info"
        };
    private string alertClass => Type.ToLower() switch
        {
            "warning" => "alert-warning" + (isVisible ? " show" : " d-none"),
            "danger" => "alert-danger" + (isVisible ? " show" : " d-none"),
            "success" => "alert-success" + (isVisible ? " show" : " d-none"),
            "primary" => "alert-primary" + (isVisible ? " show" : " d-none"),
            "secondary" => "alert-secondary" + (isVisible ? " show" : " d-none"),
            _ => "alert-info" + (isVisible ? " show" : " d-none"),
        };
}
