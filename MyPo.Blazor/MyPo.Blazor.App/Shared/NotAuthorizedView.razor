@using MyPo.Blazor.App.Shared

<PageTitle>@PageTitle</PageTitle>

<CFullpageAlert type="unauth" title="Not Authorized">
	You dont have permissions to access this page.
	<br />
	Please <a href="@LoginUrl" class="alert-link">login</a> with an account that has the required permissions.
</CFullpageAlert>

@code {
    [Parameter]
    public string LoginUrl { get; set; } = UIGlobals.ROUTE_LOGIN;

    [Parameter]
    public string PageTitle { get; set; } = "Not Authorized";
}
