@using MyPo.Blazor.App.Shared

<div class="sidebar sidebar-dark sidebar-fixed border-end" id="sidebar">
    <div class="sidebar-header border-bottom">
        @* <div class="sidebar-brand"> *@
		<a href="javascript:void(0);" @onclick="() => NavigationManager.NavigateTo(UIGlobals.ROUTE_LANDING, true)" class="sidebar-brand">
            <BlSvg url="@(UIGlobals.COREUI_BASE+"/assets/brand/coreui.svg#full")" className="sidebar-brand-full" width=88 height=32 alt="CoreUI Logo" />
            <BlSvg url="@(UIGlobals.COREUI_BASE+"/assets/brand/coreui.svg#signet")" className="sidebar-brand-narrow" width=32 height=32 alt="CoreUI Logo" />
            <!--
            <svg class="sidebar-brand-full" width="88" height="32" alt="CoreUI Logo">
                <use xlink:href="@UIGlobals.COREUI_BASE/assets/brand/coreui.svg#full"></use>
            </svg>
            <svg class="sidebar-brand-narrow" width="32" height="32" alt="CoreUI Logo">
                <use xlink:href="@UIGlobals.COREUI_BASE/assets/brand/coreui.svg#signet"></use>
            </svg>
            -->
		</a>
        @* </div> *@
        <button class="btn-close d-lg-none" type="button" data-coreui-dismiss="offcanvas" data-coreui-theme="dark" aria-label="Close" onclick="coreui.Sidebar.getInstance(document.querySelector('#sidebar')).toggle()"></button>
    </div>
    <ul class="sidebar-nav" data-coreui="navigation" data-simplebar="">
        <li class="nav-item">
            <a class="nav-link" href="@UIGlobals.ROUTE_HOME">
                <CIcon icon="cil-speedometer" extraClassName="nav-icon"/> Dashboard
            </a>
        </li>

		@foreach (var entry in Entries)
		{
			if (entry is SidebarItem)
			{
				var item = (SidebarItem)entry;
				<li class="nav-item">
					<a class="nav-link" href="@item.Url">
						@if (!string.IsNullOrEmpty(item.Icon) && (item.Icon.StartsWith("cil-") || item.Icon.StartsWith("cif-") || item.Icon.StartsWith("cib-")))
						{
							<CIcon icon="@item.Icon" extraClassName="nav-icon" />
						}
						else if (!string.IsNullOrEmpty(item.Icon) && item.Icon.StartsWith("bi-"))
						{
							<BIcon icon="@item.Icon" extraClassName="nav-icon" />
						}
						@item.Label
					</a>
				</li>
			}
			else if (entry is SidebarSection)
			{
				var section = (SidebarSection)entry;
				<li class="nav-title">@(section.Label)</li>
				@foreach (var item in section.Items)
				{
					<li class="nav-item">
						<a class="nav-link" href="@item.Url">
							@if (!string.IsNullOrEmpty(item.Icon) && (item.Icon.StartsWith("cil-") || item.Icon.StartsWith("cif-") || item.Icon.StartsWith("cib-")))
							{
								<CIcon icon="@item.Icon" extraClassName="nav-icon" />
							}
							else if (!string.IsNullOrEmpty(item.Icon) && item.Icon.StartsWith("bi-"))
							{
								<BIcon icon="@item.Icon" extraClassName="nav-icon" />
							}
							@item.Label
						</a>
					</li>
				}
			}
		}

		<li class="nav-title">Identity</li>
        <li class="nav-item">
            <a class="nav-link" href="@UIGlobals.ROUTE_IDENTITY_USERS">
				<BIcon icon="bi-people" extraClassName="nav-icon" /> Users
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="@UIGlobals.ROUTE_IDENTITY_ROLES">
                <BIcon icon="bi-person-lines-fill" extraClassName="nav-icon" /> Roles
            </a>
        </li>

		<li class="nav-title">Documents</li>
		<li class="nav-item">
			<a class="nav-link" target="_blank" href="https://coreui.io/demos/bootstrap/5.0/free/">
				<CIcon icon="cib-coreui-c" extraClassName="nav-icon" /> CoreUI Bootstrap Demo
			</a>
			<a class="nav-link" target="_blank" href="https://coreui.io/bootstrap/docs/getting-started/introduction/">
				<CIcon icon="cib-coreui-c" extraClassName="nav-icon" /> CoreUI Bootstrap Docs
			</a>
			<a class="nav-link" target="_blank" href="https://coreui.io/icons/">
				<CIcon icon="cib-coreui-c" extraClassName="nav-icon" /> CoreUI Icons
			</a>
			<a class="nav-link" target="_blank" href="https://icons.getbootstrap.com/">
				<CIcon icon="cib-bootstrap" extraClassName="nav-icon" /> Bootstrap Icons
			</a>
		</li>
    </ul>
    <div class="sidebar-footer border-top d-none d-md-flex">
        <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable"></button>
    </div>
</div>
