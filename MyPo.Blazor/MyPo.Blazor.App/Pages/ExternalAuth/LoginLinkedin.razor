@using MyPo.Blazor.App.Shared
@using Microsoft.AspNetCore.WebUtilities;
@using System.Text.Json;
@using MyPo.Blazor.App.Helpers;

@attribute [Route(UIGlobals.ROUTE_LOGIN_EXTERNAL_LINKEDIN)]
@layout Layout.Empty
@inherits LoginExternalBase

<div class="container">
	@if (!string.IsNullOrEmpty(AlertMessage))
	{
		<CAlert type="@AlertType">
			@AlertMessage
		</CAlert>
	}
	@if (ShowReturnLinks)
	{
		<CAlert type="info">
			Return to <a href="javascript:;" @onclick="() => ForceLoad(UIGlobals.ROUTE_HOME)">Home</a> or <a href="javascript:;" @onclick="() => ForceLoad(UIGlobals.ROUTE_LOGIN)">Login</a> page.
		</CAlert>
	}
</div>
