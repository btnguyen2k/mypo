@using MyPo.Blazor.App.Shared
@using Microsoft.AspNetCore.WebUtilities;
@using System.Text.Json;
@using MyPo.Blazor.App.Helpers;

@attribute [Route(UIGlobals.ROUTE_LOGIN_EXTERNAL_LINKEDIN)]
@layout Layout.Empty
@inherits LoginExternalBase

<CFullpageAlert type="@AlertType" title="@AlertTitle">
	<p>@AlertMessage</p>
	@if (ShowReturnLinks)
	{
		<p>
			Return to <a href="@UIGlobals.ROUTE_HOME" @onclick="() => ForceLoad(UIGlobals.ROUTE_HOME)" @onclick:preventDefault>Home</a> or
			<a href="@UIGlobals.ROUTE_LOGIN" @onclick="() => ForceLoad(UIGlobals.ROUTE_LOGIN)" @onclick:preventDefault>Login</a> page.
		</p>
	}
</CFullpageAlert>
