{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  // Custom bootstrapping settings
  "Bootstrap": {
    // additional assemblies to look for bootstrappers
    "Assemblies": [
      "MyPo.Blazor.App",
      "MyPo.Blazor.Portfolio.App"
    ]
  },

  // Authentication settings
  "Authentication": {
    "DisabledLocalAuth": true, // if true, local authentication (username/password) is disabled
  },

  "API": {
    // Base URL of the API backend (Blazor WASM mode)
    // - On development environment, this value can be empty, then the BaseUrl is automatically obtained from the (WebAssemblyHostBuilder).HostEnvironment or NavigationManager. Or match this value with the one defined in the project MyPo.Blazor's Properties/launchSettings.json file.
    // - Or populate this value with the base URL of the API backend.
    "BaseUrl": ""
  },

  "END": {
    // [dummy] ending block which does not have the closing comma
  }
}
